# =============================================================================
# ForgeSRE deployment — repo-root `.env`
# =============================================================================
# Purpose: ports, paths, compose profiles, and paths to generated monitoring YAML.
# Install: ./install.sh copies this file to `.env` and fills values (new VM only).
# Manual:  cp .env.example .env   then edit. Never commit the live `.env`.
#
# Secrets (passwords, tokens, SECRET_KEY) belong in secrets/secrets.env — see
# secrets/secrets.example.env. Do not merge the two files.
#
# Some password-like keys below are duplicated into `.env` only so Docker Compose
# can interpolate ${VAR} in docker-compose.yml. The authoritative secret file is
# still secrets/secrets.env (plaintext env for containers — not bcrypt hashes).
# ForgeSRE UI user passwords are bcrypt only inside Postgres after first boot.
# =============================================================================

# --- Appliance ---
# Product version label (informational; install sets the current release).
FORGESRE_VERSION=0.7.0
# Default DNS-style name used by optional mailbox / mail domain fallbacks.
FORGESRE_DOMAIN=forgesre.local
# Persistent data directory (Postgres volume, logs, models, backups, generated YAML).
FORGESRE_DATA=./data
# IANA timezone for Core and related tooling.
FORGESRE_TIMEZONE=Europe/Belgrade
# Install profile name (standard | full-ai). Does not replace COMPOSE_PROFILES.
FORGESRE_PROFILE=standard

# --- Ports ---
# ForgeSRE Core HTTP (UI + API). Open from the management network.
FORGESRE_HTTP_PORT=8080
# Bundled Grafana listen port (open from System Health).
GRAFANA_PORT=3000
# Bundled NetBox UI (default on, no compose profile).
NETBOX_PORT=8001

# --- Compose profiles ---
# Empty = default stack only. Values: ai | mailbox | ai,mailbox
# NetBox is not a profile — it always starts with the default stack.
COMPOSE_PROFILES=
# llama.cpp CPU threads when profile `ai` is on (fetch-llm often sets nproc-2).
FORGESRE_LLM_THREADS=8

# --- NetBox URL (Core) ---
# Where Core calls NetBox. Bundled default is localhost on NETBOX_PORT.
NETBOX_URL=http://127.0.0.1:8001

# --- NetBox / DB passwords mirrored for Compose interpolation ---
# Leave empty in the example. Install writes real values into both `.env` and
# secrets/secrets.env. Prefer editing secrets/secrets.env, then keep `.env` in
# sync (or re-run scripts/ensure-netbox-secrets.sh / ./forgesre update).
# NETBOX_SUPERUSER_* = NetBox Django admin for the UI at :8001 (plaintext for the container).
NETBOX_SUPERUSER_NAME=admin
NETBOX_SUPERUSER_EMAIL=admin@forgesre.local
NETBOX_SUPERUSER_PASSWORD=
NETBOX_DB_PASSWORD=
NETBOX_REDIS_PASSWORD=
NETBOX_SECRET_KEY=
# Prefer full NetBox UI v2 token (nbt_…). 40-char v1 is launch fallback.
NETBOX_API_TOKEN=
# NetBox v4.5+ UI token hashing; compose maps to API_TOKEN_PEPPER_1 (≥50 chars).
NETBOX_API_TOKEN_PEPPER=
# ForgeSRE Postgres password (compose ${POSTGRES_PASSWORD} for service postgres).
POSTGRES_PASSWORD=
# Grafana admin password (compose ${GRAFANA_ADMIN_PASSWORD}).
GRAFANA_ADMIN_PASSWORD=

# --- Generated monitoring paths (written under FORGESRE_DATA) ---
# Filled by install / ./forgesre render-monitoring. Do not point these at secrets.
ALERTMANAGER_CONFIG=./data/generated/alertmanager.yml
PROMETHEUS_CONFIG=./data/generated/prometheus.yml
PROMETHEUS_ALERTS=./data/generated/alerts.yml
SNMP_EXPORTER_CONFIG=./data/generated/snmp.yml

# --- Optional mailbox (docker-mailserver + Roundcube) ---
# Enable with: ./forgesre mailbox   (sets COMPOSE_PROFILES to include mailbox).
# MAIL_DOMAIN=forgesre.local
# ROUNDCUBE_PORT=8081
# ROUNDCUBEMAIL_DES_KEY=
