# Deployment only. Application config: config/forgesre.yml
# Secrets: secrets/secrets.env

FORGESRE_VERSION=0.4.0
FORGESRE_DOMAIN=forgesre.local
FORGESRE_DATA=./data
FORGESRE_TIMEZONE=Europe/Belgrade
FORGESRE_HTTP_PORT=8080
GRAFANA_PORT=3000
FORGESRE_PROFILE=standard
COMPOSE_PROFILES=
# Optional: mailbox (docker-mailserver + Roundcube, ./forgesre mailbox)
# MAIL_DOMAIN=forgesre.local
# ROUNDCUBE_PORT=8081
FORGESRE_LLM_THREADS=8
# Bundled NetBox (default on, no compose profile). UI: http://<VM-IP>:8001
# Image pin is in git docker-compose.yml (not this file).
NETBOX_PORT=8001
NETBOX_URL=http://127.0.0.1:8001
# NETBOX_DB_PASSWORD=
# NETBOX_REDIS_PASSWORD=
# NETBOX_SECRET_KEY=
# NETBOX_API_TOKEN=
# NETBOX_SUPERUSER_NAME=admin
# NETBOX_SUPERUSER_EMAIL=admin@forgesre.local
# NETBOX_SUPERUSER_PASSWORD=
