# =============================================================================
# ForgeSRE deployment — repo-root `.env`
# =============================================================================
# Purpose: ports, paths, compose profiles, and paths to generated monitoring YAML.
# Where:   next to docker-compose.yml (repo root). Live file is gitignored.
# Install: ./install.sh copies this file to `.env` and fills values (new VM only).
# Manual:  cp .env.example .env   then edit. Never commit the live `.env`.
#
# Secrets (passwords, tokens, SECRET_KEY) belong in secrets/secrets.env — see
# secrets/secrets.example.env. Do not merge the two files.
#
# Some password-like keys below are duplicated into `.env` only so Docker Compose
# can interpolate ${VAR} in docker-compose.yml. The authoritative secret file is
# still secrets/secrets.env (plaintext env for containers — not bcrypt hashes).
# ForgeSRE UI user passwords are bcrypt only inside Postgres after first boot.
# =============================================================================

# --- Appliance ---
# Product version label (informational; install sets the current release).
FORGESRE_VERSION=2.0.0
# Default DNS-style name used by optional mailbox / mail domain fallbacks.
FORGESRE_DOMAIN=forgesre.local
# Persistent data directory (Postgres volume, logs, models, backups, generated YAML).
FORGESRE_DATA=./data
# IANA timezone for Core and related tooling.
FORGESRE_TIMEZONE=Europe/Belgrade
# Install profile name (standard | full-ai). Does not replace COMPOSE_PROFILES.
FORGESRE_PROFILE=standard
# ForgeSRE Core HTTP (UI + API). Open from the management network.
FORGESRE_HTTP_PORT=8080
# HTTPS front (./forgesre https on|only|off). Set by scripts/https.sh; FORGESRE_HTTPS_PORT can be changed here.
# FORGESRE_HTTPS=off
# FORGESRE_HTTPS_PORT=443
# FORGESRE_BIND=127.0.0.1        # only with "https only"

# --- Compose profiles ---
# Optional parts, comma separated: netbox, librenms (bundled, on by default), https (./forgesre https),
# ai (local model), mailbox, worker. Change NetBox / LibreNMS with ./forgesre optional.
COMPOSE_PROFILES=netbox,librenms
# Set once update has added netbox,librenms to an appliance from before they were optional.
FORGESRE_OPTIONAL_PROFILES=1
# llama.cpp CPU threads when profile `ai` is on (fetch-llm often sets nproc-2).
FORGESRE_LLM_THREADS=8
# llama.cpp context window in tokens (prompt + answer). 8192 fits every catalog model;
# more costs RAM and does not make answers faster. See docs/vodic-sr.md §9.
FORGESRE_LLM_CTX=8192
# GPU build only (./forgesre gpu on): model layers on the GPU, 99 = all; lower when GPU memory is short.
# FORGESRE_LLM_GPU_LAYERS=99
# CPU threads of the document-search embedding model (ForgeAI RAG); 2 is plenty.
# FORGESRE_EMBED_THREADS=2
# ForgeAI answer length and thinking room are not here: Settings › RCA / AI (ai.llm.answer_percent,
# ai.llm.think_tokens in config/forgesre.yml), applied without a restart.
# All values below can also be changed in Settings › Server when the apply helper is on
# (./forgesre apply-helper on); it writes this file and restarts only the containers that use them.

# --- Core web ---
# Core web processes; more than 1 needs the worker profile (FORGESRE_CORE_ROLE=web + worker).
# FORGESRE_WEB_WORKERS=1
# FORGESRE_CORE_ROLE=all

# --- Postgres ---
# Compose ${POSTGRES_PASSWORD} for service postgres. Canonical value lives in
# secrets/secrets.env (plaintext). Keep both files in sync after install.
POSTGRES_PASSWORD=

# --- Grafana ---
# Bundled Grafana listen port (open from System Health).
GRAFANA_PORT=3000
# Compose ${GRAFANA_ADMIN_PASSWORD}. Canonical value in secrets/secrets.env.
GRAFANA_ADMIN_PASSWORD=

# --- Containers view ---
# docker-ro (read-only Docker window for Settings › Containers) listens on 127.0.0.1 only.
FORGESRE_DOCKER_RO_PORT=2377

# --- NetBox ---
# Bundled NetBox UI port (default on, no compose profile).
NETBOX_PORT=8001
# Where Core calls NetBox. Bundled default is localhost on NETBOX_PORT.
NETBOX_URL=http://127.0.0.1:8001
# Leave empty in the example. Install writes real values into both `.env` and
# secrets/secrets.env. Prefer editing secrets/secrets.env, then keep `.env` in
# sync (or re-run scripts/ensure-netbox-secrets.sh / ./forgesre update).
# NETBOX_SUPERUSER_* = NetBox Django admin for the UI at :8001 (plaintext).
NETBOX_SUPERUSER_NAME=admin
NETBOX_SUPERUSER_EMAIL=admin@forgesre.local
NETBOX_SUPERUSER_PASSWORD=
NETBOX_DB_PASSWORD=
NETBOX_REDIS_PASSWORD=
NETBOX_SECRET_KEY=
# Prefer full NetBox UI v2 token (nbt_…). 40-char v1 is launch fallback.
NETBOX_API_TOKEN=
# NetBox v4.5+ UI token hashing; compose maps to API_TOKEN_PEPPER_1 (≥50 chars).
NETBOX_API_TOKEN_PEPPER=

# --- LibreNMS ---
# Bundled LibreNMS UI (Discovery SNMP Identify). NetBox stays on NETBOX_PORT.
LIBRENMS_URL=http://127.0.0.1:8000
# Canonical values in secrets/secrets.env (filled by ensure-librenms-secrets.sh).
# APP_KEY is not interpolated from here (empty .env would override env_file).
LIBRENMS_DB_PASSWORD=
LIBRENMS_DB_ROOT_PASSWORD=
LIBRENMS_REDIS_PASSWORD=
LIBRENMS_APP_KEY=

# --- Generated monitoring ---
# Written under FORGESRE_DATA by install / ./forgesre render-monitoring.
# Do not point these at secrets.
ALERTMANAGER_CONFIG=./data/generated/alertmanager.yml
PROMETHEUS_CONFIG=./data/generated/prometheus.yml
PROMETHEUS_ALERTS=./data/generated/alerts.yml
SNMP_EXPORTER_CONFIG=./data/generated/snmp.yml
# Alloy syslog receiver + demo Core log pipeline. Loki stays on 127.0.0.1:3100.
ALLOY_CONFIG=./data/generated/config.alloy
LOKI_CONFIG=./data/generated/loki.yml

# --- Optional mailbox ---
# Enable with: ./forgesre mailbox   (sets COMPOSE_PROFILES to include mailbox).
# MAIL_DOMAIN=forgesre.local
# ROUNDCUBE_PORT=8081
# ROUNDCUBEMAIL_DES_KEY=

# --- Nightly backup (./forgesre backup schedule on) keeps this many local runs ---
# FORGESRE_BACKUP_KEEP=14

# --- Off-box backup copy (docs/operator-handbook.md) ---
# FORGESRE_OFFBOX=dir                       # or s3; empty = off
# FORGESRE_OFFBOX_PATH=/mnt/nfs/forgesre    # dir: a mounted NFS / SMB share
# FORGESRE_OFFBOX_S3_URL=https://s3.dc.local:9000
# FORGESRE_OFFBOX_S3_BUCKET=forgesre-backups
# FORGESRE_OFFBOX_S3_PREFIX=forgesre
# FORGESRE_OFFBOX_S3_REGION=us-east-1
# FORGESRE_OFFBOX_KEEP=14
# FORGESRE_OFFBOX_STRIP=no                  # yes: leave secrets.env and .env out of the copy
