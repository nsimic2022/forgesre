# Deployment / environment only. Application config lives in config/forgesre.yml.
# Copy to .env and adjust. Do not put passwords here; use secrets/secrets.env.

FORGESRE_VERSION=0.1.0
FORGESRE_DOMAIN=forgesre.local
FORGESRE_DATA=/opt/forgesre/data
FORGESRE_TIMEZONE=Europe/Belgrade
FORGESRE_PROFILE=minimal
FORGESRE_HTTP_PORT=443
FORGESRE_BIND=0.0.0.0

# Docker Compose profiles: minimal | standard | ai
# Combined example for Full AI: COMPOSE_PROFILES=minimal,standard,ai
COMPOSE_PROFILES=minimal
