# Deployment only. Application config: config/forgesre.yml
# Secrets: secrets/secrets.env

FORGESRE_VERSION=0.4.0
FORGESRE_DOMAIN=forgesre.local
FORGESRE_DATA=./data
FORGESRE_TIMEZONE=Europe/Belgrade
FORGESRE_HTTP_PORT=8080
GRAFANA_PORT=3000
FORGESRE_PROFILE=standard
COMPOSE_PROFILES=
# Optional: mailbox (docker-mailserver + Roundcube, ./forgesre mailbox)
# MAIL_DOMAIN=forgesre.local
# ROUNDCUBE_PORT=8081
FORGESRE_LLM_THREADS=8
