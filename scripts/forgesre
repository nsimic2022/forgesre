#!/usr/bin/env bash
# ForgeSRE host CLI. Run from the clone directory: ./forgesre <command>
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

cmd="${1:-help}"
shift || true

if docker info >/dev/null 2>&1; then DC=(docker compose); else DC=(sudo docker compose); fi

port_from_env() {
  local port="8080"
  if [[ -f .env ]]; then
    port="$(awk -F= '/FORGESRE_HTTP_PORT/ {print $2}' .env | tail -1 | tr -d '"' || true)"
  fi
  echo "${port:-8080}"
}

need_env() {
  if [[ ! -f .env || ! -f secrets/secrets.env ]]; then
    echo "This command needs an installed appliance (.env and secrets/secrets.env)."
    echo "New VM: ./forgesre install"
    echo "Existing VM: do not re-run install.sh; git pull && ./forgesre update"
    exit 1
  fi
}

print_overview() {
  cat <<'EOF'
ForgeSRE CLI — operate the appliance from the clone directory.

Usage:
  ./forgesre <command> [args]
  ./forgesre help [command]

Do not re-run ./install.sh on a live box. That regenerates passwords.
Existing VM after git pull:
  ./forgesre render-monitoring
  ./forgesre update
  ./forgesre doctor

Commands:
  help [command]     This overview, or detailed help for one command
  install            Guided first-time install (new VM only)
  doctor             Health checks (Core, Prometheus, snmp-exporter, …)
  status             docker compose ps
  logs [service]     Container logs (default: last 100 lines)
  config             Print config/forgesre.yml
  assets             List inventory (alias: inventory)
  snmp               snmp_exporter health + SNMP HTTP SD targets
  render-monitoring  Rewrite Prometheus / Alertmanager / snmp.yml from templates
  journal [module]   Internal console reports (JSON)
  demo               HighCPU first-hour path (owner mail, similar history)
  demo-rca           Filesystem RCA demo gauge (read-only)
  demo-reset         Lower demo CPU/disk gauges (stops the demo HighCPU fire)
  jobs               Background RCA job queue
  incidents          Open/recent incidents
  sd                 Prometheus HTTP SD (Linux) and SNMP HTTP SD
  version            Appliance version from .env
  secrets-check      Refuse-to-start defaults: SECRET_KEY / webhook token
  fetch-llm          Download Qwen 14B GGUF (~9 GB, not in git) and start llama.cpp
  backup             Dump Postgres + config (tar mode 600; --no-secrets omits secrets.env)
  restore            Print restore steps (does not run them)
  update             Backup, render monitoring, refresh images, restart, doctor

Examples:
  ./forgesre help snmp
  ./forgesre assets
  ./forgesre snmp
  ./forgesre jobs
  ./forgesre incidents
  ./forgesre sd
  ./forgesre demo-reset
  ./forgesre secrets-check
  ./forgesre journal snmp
  ./forgesre logs snmp-exporter
  ./forgesre render-monitoring && docker compose up -d
EOF
}

print_help_command() {
  local name="${1:-}"
  case "$name" in
    help)
      cat <<'EOF'
help — show CLI overview or one command.

  ./forgesre
  ./forgesre help
  ./forgesre help snmp
EOF
      ;;
    install)
      cat <<'EOF'
install — first-time wizard. Writes .env, secrets, config, starts Compose.

  ./forgesre install
  ./forgesre install --non-interactive --profile standard --port 8080

Do NOT run this on a VM that already has secrets. Use update / render-monitoring.
EOF
      ;;
    doctor)
      cat <<'EOF'
doctor — same checks as /health-ui. Overall HEALTHY or DEGRADED.

  ./forgesre doctor
  ./doctor.sh

snmp: error means the snmp-exporter container is down or :9116 is not listening.
Fix: docker compose up -d snmp-exporter && ./forgesre snmp
EOF
      ;;
    status)
      cat <<'EOF'
status — docker compose ps (host networking; ports are on localhost).

  ./forgesre status
EOF
      ;;
    logs)
      cat <<'EOF'
logs — docker compose logs --tail 100.

  ./forgesre logs
  ./forgesre logs core
  ./forgesre logs snmp-exporter
  ./forgesre logs prometheus
EOF
      ;;
    config)
      cat <<'EOF'
config — print the first 160 lines of config/forgesre.yml.

  ./forgesre config

After editing YAML, recreate Core:
  docker compose up -d --force-recreate core
EOF
      ;;
    assets|inventory)
      cat <<'EOF'
assets — list inventory from the Core API (login as the install admin).

  ./forgesre assets
  ./forgesre inventory          # same command

Linux hosts with scrape_address are Prometheus node_exporter targets (:9100).
Rows with type "Network device" and an IP are snmp_exporter targets (UDP/161).

Add a switch in the UI (Assets → Add asset) or:
  # after UI login cookie, or use the form
  See docs/operator-handbook.md §6 and §7.
EOF
      ;;
    snmp)
      cat <<'EOF'
snmp — check bundled snmp_exporter and list SNMP HTTP SD targets.

  ./forgesre snmp
  ./forgesre journal snmp
  ./forgesre logs snmp-exporter

What you should see:
  - HTTP 200 from http://127.0.0.1:9116/metrics
  - JSON list from /api/v1/sd/snmp (Bearer ALERTMANAGER_WEBHOOK_TOKEN)
  - Empty JSON [] until you add a Network device with an IP

Linux node_exporter hosts are never SNMP-scraped.
snmp_exporter walks UDP/161 from this host using SNMP_COMMUNITY
(default public, stored in secrets/secrets.env). Allow UDP/161 outbound
from the ForgeSRE VM to the device; the device ACL must allow this host.

Change community, then re-render (do not re-install):

  # edit SNMP_COMMUNITY in secrets/secrets.env
  ./forgesre render-monitoring
  docker compose up -d snmp-exporter
EOF
      ;;
    render-monitoring)
      cat <<'EOF'
render-monitoring — regenerate generated Prometheus / Alertmanager / snmp.yml.

Use this on an existing VM after git pull so the new forgesre-snmp job appears
without running ./install.sh.

  ./forgesre render-monitoring
  docker compose up -d
  ./forgesre doctor

Reads ALERTMANAGER_WEBHOOK_TOKEN and SNMP_COMMUNITY from secrets/secrets.env.
Writes $FORGESRE_DATA/generated/{prometheus,alertmanager,snmp,alerts}.yml
and sets SNMP_EXPORTER_CONFIG / PROMETHEUS_ALERTS in .env if missing.

Optional extra Prometheus rules: copy monitoring/alerts.local.yml.example
to monitoring/alerts.local.yml (gitignored). It is concatenated after the
bundled alerts.yml.
EOF
      ;;
    journal)
      cat <<'EOF'
journal — internal console reports (JSON). Not Docker logs.

  ./forgesre journal
  ./forgesre journal inventory
  ./forgesre journal snmp
  ./forgesre journal demo

Modules include install, seed, inventory, discovery, snmp, incident, rca,
jobs, notification, demo. UI: /journal
EOF
      ;;
    demo)
      cat <<'EOF'
demo — first-hour HighCPU path on forge-demo-01 (demo gauge, not a real host).

  ./forgesre demo

Then: Dashboard → incident → Who to call → Escalation → Console.
EOF
      ;;
    demo-rca)
      cat <<'EOF'
demo-rca — filesystem RCA on the demo disk gauge. Read-only. Does not fill a disk.

  ./forgesre demo-rca
EOF
      ;;
    demo-reset)
      cat <<'EOF'
demo-reset — set demo CPU/disk gauges back to 12% / 35%.

Use after ./forgesre demo so HighCPU does not stay firing forever.

  ./forgesre demo-reset
EOF
      ;;
    jobs)
      cat <<'EOF'
jobs — list background RCA jobs (pending / running / done / error).

Alertmanager webhooks enqueue investigate; a worker thread runs them
so the webhook does not wait on the LLM.

  ./forgesre jobs
EOF
      ;;
    secrets-check)
      cat <<'EOF'
secrets-check — verify SECRET_KEY and ALERTMANAGER_WEBHOOK_TOKEN are not shipped defaults.

Core refuses to start with those defaults unless FORGESRE_DEV=1.

  ./forgesre secrets-check
EOF
      ;;
    fetch-llm)
      cat <<'EOF'
fetch-llm — download Qwen 14B GGUF (~9 GB) into $FORGESRE_DATA/models/ and start llama.cpp.

  ./forgesre fetch-llm
  ./forgesre doctor          # llm: ok when the server answers

Not stored in git. RCA works without it (builtin analyst).
EOF
      ;;
    backup)
      cat <<'EOF'
backup — Postgres dump + config tarball under $FORGESRE_DATA/backups.

  ./forgesre backup
  ./forgesre backup --no-secrets
  ./backup.sh --no-secrets

The tar is mode 600. Default includes secrets.env. --no-secrets omits it
so the archive can sit on a less-trusted disk; keep secrets elsewhere.
EOF
      ;;
    restore)
      cat <<'EOF'
restore — not automated. Unpack a backup and load SQL:

  docker compose exec -T postgres psql -U forgesre forgesre < forgesre.sql
EOF
      ;;
    incidents)
      cat <<'EOF'
incidents — list recent incidents from the Core API.

  ./forgesre incidents
EOF
      ;;
    sd)
      cat <<'EOF'
sd — print Prometheus HTTP SD (Linux node_exporter) and SNMP HTTP SD.

  ./forgesre sd

Uses ALERTMANAGER_WEBHOOK_TOKEN. Empty SNMP [] is normal until a Network
device with an IP exists. Linux hosts with scrape_address appear in the
first list; they are never SNMP-scraped.
EOF
      ;;
    version)
      cat <<'EOF'
version — print FORGESRE_VERSION from .env (0.6.0 after this release).

  ./forgesre version
EOF
      ;;
    tls)
      cat <<'EOF'
tls — optional HTTPS in front of Core. Not a Compose service.

Example Caddyfile: tls/Caddyfile.example

Then set FORGESRE_COOKIE_SECURE=1 (or system.cookie_secure: true in YAML)
and recreate Core so the session cookie is Secure:

  docker compose up -d --force-recreate core

Lab default stays HTTP on the management VLAN.
EOF
      ;;
    update)
      cat <<'EOF'
update — doctor (warn ok), backup, render-monitoring, compose pull/up, doctor.

  ./forgesre update
  ./forgesre update --offline

Use this after git pull origin main. Do not run ./install.sh.
EOF
      ;;
    "")
      print_overview
      ;;
    *)
      echo "No detailed help for '$name'."
      echo
      print_overview
      return 1
      ;;
  esac
}

cmd_assets() {
  need_env
  python3 - "$(port_from_env)" <<'PY'
import json, os, sys, tempfile, subprocess, pathlib

port = sys.argv[1]
root = pathlib.Path(".").resolve()
# load secrets
env = {}
for line in (root / "secrets/secrets.env").read_text().splitlines():
    if not line or line.startswith("#") or "=" not in line:
        continue
    k, _, v = line.partition("=")
    env[k] = v
email = env.get("FORGESRE_ADMIN_EMAIL", "")
password = env.get("FORGESRE_ADMIN_PASSWORD", "")
jar = tempfile.NamedTemporaryFile(delete=False)
jar.close()
try:
    subprocess.check_call(
        [
            "curl", "-fsS", "-c", jar.name, "-b", jar.name,
            "-X", "POST", f"http://127.0.0.1:{port}/login",
            "-d", f"email={email}&password={password}",
        ],
        stdout=subprocess.DEVNULL,
    )
    raw = subprocess.check_output(
        ["curl", "-fsS", "-c", jar.name, "-b", jar.name, f"http://127.0.0.1:{port}/api/v1/assets"]
    )
finally:
    os.unlink(jar.name)
rows = json.loads(raw)
print(f"{'ASSET':<22} {'IP':<16} {'TYPE':<22} {'SCRAPE / SNMP'}")
print("-" * 78)
for item in rows:
    scrape = item.get("scrape_address") or ""
    extra = scrape if scrape else ("SNMP UDP/161" if item.get("snmp") else "—")
    print(f"{item.get('asset_id',''):<22} {item.get('ip',''):<16} {str(item.get('type',''))[:22]:<22} {extra}")
print()
print(f"{len(rows)} asset(s). Linux = node_exporter :9100. Network device + IP = snmp_exporter.")
PY
}

cmd_snmp() {
  need_env
  local port code
  port="$(port_from_env)"
  # shellcheck disable=SC1091
  source secrets/secrets.env
  echo "=== snmp-exporter ==="
  code="$(curl -sS -o /tmp/forgesre-snmp-metrics.txt -w "%{http_code}" http://127.0.0.1:9116/metrics || true)"
  echo "GET http://127.0.0.1:9116/metrics  HTTP ${code:-down}"
  if [[ "${code:-}" != "200" ]]; then
    echo "Exporter is not up. Start it: docker compose up -d snmp-exporter"
    echo "Then: ./forgesre logs snmp-exporter"
  fi
  echo
  echo "=== SNMP HTTP SD (network devices with an IP) ==="
  curl -sS -H "Authorization: Bearer ${ALERTMANAGER_WEBHOOK_TOKEN}" \
    "http://127.0.0.1:${port}/api/v1/sd/snmp" || true
  echo
  echo
  echo "Empty list [] is normal until you add type=Network device with an IP."
  echo "Community: SNMP_COMMUNITY in secrets/secrets.env (not printed here)."
  echo "Firewall: UDP/161 from this host to the device. Discovery classifies with an SNMP GET (UDP), not TCP/161."
  echo "Alerts: SnmpDeviceUnreachable (up{job=\"forgesre-snmp\"}==0 for 2m)."
}

case "$cmd" in
  help)
    print_help_command "${1:-}"
    ;;
  install) exec "$ROOT/scripts/install.sh" "$@" ;;
  doctor) exec "$ROOT/scripts/doctor.sh" "$@" ;;
  backup) exec "$ROOT/scripts/backup.sh" "$@" ;;
  restore)
    print_help_command restore
    exit 1
    ;;
  update) exec "$ROOT/scripts/update.sh" "$@" ;;
  fetch-llm)
    exec "$ROOT/scripts/fetch-llm.sh" "$@"
    ;;
  render-monitoring)
    exec "$ROOT/scripts/render-monitoring.sh" "$@"
    ;;
  demo)
    need_env
    PORT="$(port_from_env)"
    # shellcheck disable=SC1091
    source secrets/secrets.env
    echo "Generating demo incident workflow..."
    jar="$(mktemp)"
    curl -fsS -c "$jar" -b "$jar" -X POST "http://127.0.0.1:${PORT}/login" \
      -d "email=${FORGESRE_ADMIN_EMAIL}&password=${FORGESRE_ADMIN_PASSWORD}" >/dev/null
    curl -fsS -c "$jar" -b "$jar" -X POST "http://127.0.0.1:${PORT}/api/v1/demo"
    echo
    echo "Open the UI dashboard, then:"
    echo "  1. Asset forge-demo-01 (owner contacts + similar HighCPU history)"
    echo "  2. The new incident (Who to call = platform@forgesre.local)"
    echo "  3. /escalation for the generated owner notification"
    echo "Demo discovery candidate: 10.20.30.41 on /discovery"
    rm -f "$jar"
    ;;
  demo-rca)
    need_env
    PORT="$(port_from_env)"
    # shellcheck disable=SC1091
    source secrets/secrets.env
    echo "Generating filesystem RCA demo..."
    jar="$(mktemp)"
    curl -fsS -c "$jar" -b "$jar" -X POST "http://127.0.0.1:${PORT}/login" \
      -d "email=${FORGESRE_ADMIN_EMAIL}&password=${FORGESRE_ADMIN_PASSWORD}" >/dev/null
    curl -fsS -c "$jar" -b "$jar" -X POST "http://127.0.0.1:${PORT}/api/v1/demo-rca"
    echo
    rm -f "$jar"
    ;;
  demo-reset)
    need_env
    PORT="$(port_from_env)"
    # shellcheck disable=SC1091
    source secrets/secrets.env
    jar="$(mktemp)"
    curl -fsS -c "$jar" -b "$jar" -X POST "http://127.0.0.1:${PORT}/login" \
      -d "email=${FORGESRE_ADMIN_EMAIL}&password=${FORGESRE_ADMIN_PASSWORD}" >/dev/null
    curl -fsS -c "$jar" -b "$jar" -X POST "http://127.0.0.1:${PORT}/api/v1/demo-reset"
    echo
    echo "Demo gauges reset to 12% CPU / 35% disk."
    rm -f "$jar"
    ;;
  jobs)
    need_env
    PORT="$(port_from_env)"
    # shellcheck disable=SC1091
    source secrets/secrets.env
    jar="$(mktemp)"
    curl -fsS -c "$jar" -b "$jar" -X POST "http://127.0.0.1:${PORT}/login" \
      -d "email=${FORGESRE_ADMIN_EMAIL}&password=${FORGESRE_ADMIN_PASSWORD}" >/dev/null
    curl -fsS -c "$jar" -b "$jar" "http://127.0.0.1:${PORT}/api/v1/jobs"
    echo
    rm -f "$jar"
    ;;
  secrets-check)
    need_env
    # shellcheck disable=SC1091
    source secrets/secrets.env
    fail=0
    if [[ "${SECRET_KEY:-}" == "forgesre-dev-secret-change-me" || -z "${SECRET_KEY:-}" ]]; then
      echo "SECRET_KEY is the shipped default — Core will refuse to start without FORGESRE_DEV=1."
      fail=1
    else
      echo "SECRET_KEY: set"
    fi
    if [[ "${ALERTMANAGER_WEBHOOK_TOKEN:-}" == "forgesre-dev-webhook-token" || "${ALERTMANAGER_WEBHOOK_TOKEN:-}" == "CHANGE-ME-RENDER-MONITORING" || -z "${ALERTMANAGER_WEBHOOK_TOKEN:-}" ]]; then
      echo "ALERTMANAGER_WEBHOOK_TOKEN is a shipped placeholder — HTTP SD and doctor will be unsafe/broken."
      fail=1
    else
      echo "ALERTMANAGER_WEBHOOK_TOKEN: set"
    fi
    exit "$fail"
    ;;
  status)
    "${DC[@]}" ps
    ;;
  logs)
    "${DC[@]}" logs --tail 100 "$@"
    ;;
  journal)
    need_env
    PORT="$(port_from_env)"
    # shellcheck disable=SC1091
    source secrets/secrets.env
    module="${1:-}"
    jar="$(mktemp)"
    curl -fsS -c "$jar" -b "$jar" -X POST "http://127.0.0.1:${PORT}/login" \
      -d "email=${FORGESRE_ADMIN_EMAIL}&password=${FORGESRE_ADMIN_PASSWORD}" >/dev/null
    if [[ -n "$module" ]]; then
      curl -fsS -c "$jar" -b "$jar" "http://127.0.0.1:${PORT}/api/v1/journal?module=${module}&limit=50"
    else
      curl -fsS -c "$jar" -b "$jar" "http://127.0.0.1:${PORT}/api/v1/journal?limit=50"
    fi
    echo
    rm -f "$jar"
    ;;
  config)
    sed -n '1,160p' config/forgesre.yml
    ;;
  assets|inventory)
    cmd_assets
    ;;
  snmp)
    cmd_snmp
    ;;
  incidents)
    need_env
    python3 - "$(port_from_env)" <<'PY'
import json, os, sys, tempfile, subprocess, pathlib

port = sys.argv[1]
root = pathlib.Path(".").resolve()
env = {}
for line in (root / "secrets/secrets.env").read_text().splitlines():
    if not line or line.startswith("#") or "=" not in line:
        continue
    k, _, v = line.partition("=")
    env[k] = v
email = env.get("FORGESRE_ADMIN_EMAIL", "")
password = env.get("FORGESRE_ADMIN_PASSWORD", "")
jar = tempfile.NamedTemporaryFile(delete=False)
jar.close()
try:
    subprocess.check_call(
        [
            "curl", "-fsS", "-c", jar.name, "-b", jar.name,
            "-X", "POST", f"http://127.0.0.1:{port}/login",
            "-d", f"email={email}&password={password}",
        ],
        stdout=subprocess.DEVNULL,
    )
    raw = subprocess.check_output(
        ["curl", "-fsS", "-c", jar.name, "-b", jar.name, f"http://127.0.0.1:{port}/api/v1/incidents?limit=30"]
    )
finally:
    os.unlink(jar.name)
rows = json.loads(raw)
print(f"{'NUMBER':<14} {'STATUS':<14} {'SEV':<10} TITLE")
print("-" * 78)
for item in rows:
    title = str(item.get("title") or "")[:40]
    print(f"{item.get('number',''):<14} {item.get('status',''):<14} {str(item.get('severity',''))[:10]:<10} {title}")
print()
print(f"{len(rows)} incident(s). RCA runs in the background (./forgesre jobs).")
PY
    ;;
  sd)
    need_env
    PORT="$(port_from_env)"
    # shellcheck disable=SC1091
    source secrets/secrets.env
    echo "=== Linux / node_exporter HTTP SD ==="
    curl -sS -H "Authorization: Bearer ${ALERTMANAGER_WEBHOOK_TOKEN}" \
      "http://127.0.0.1:${PORT}/api/v1/sd/prometheus" || true
    echo
    echo
    echo "=== SNMP HTTP SD ==="
    curl -sS -H "Authorization: Bearer ${ALERTMANAGER_WEBHOOK_TOKEN}" \
      "http://127.0.0.1:${PORT}/api/v1/sd/snmp" || true
    echo
    ;;
  version)
    if [[ -f .env ]] && grep -q '^FORGESRE_VERSION=' .env; then
      awk -F= '/^FORGESRE_VERSION=/ {print $2}' .env | tail -1 | tr -d '"'
    else
      echo "0.6.0"
    fi
    ;;
  tls)
    print_help_command tls
    ;;
  *)
    echo "Unknown command: $cmd"
    echo
    print_overview
    exit 1
    ;;
esac
