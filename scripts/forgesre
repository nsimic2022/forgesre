#!/usr/bin/env bash
# ForgeSRE host CLI. Run from the clone directory: ./forgesre <command>
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

load_secrets() {
  # Parse KEY=value — never source secrets.env (LibreNMS tokens contain `|`).
  # shellcheck source=dotenv_load.sh
  source "$ROOT/scripts/dotenv_load.sh"
  dotenv_load "$ROOT/secrets/secrets.env"
}

# First word is the subcommand; the rest ("$@") is passed on to it.
cmd="${1:-}"
shift || true

# Use plain docker when this user can reach the daemon, otherwise sudo.
if docker info >/dev/null 2>&1; then DC=(docker compose); else DC=(sudo docker compose); fi

# Core HTTP port from .env (FORGESRE_HTTP_PORT), default 8080.
port_from_env() {
  local port="8080"
  if [[ -f .env ]]; then
    port="$(awk -F= '/FORGESRE_HTTP_PORT/ {print $2}' .env | tail -1 | tr -d '"' || true)"
  fi
  echo "${port:-8080}"
}

need_env() {
  if [[ ! -f .env || ! -f secrets/secrets.env ]]; then
    echo "This command needs an installed appliance (.env and secrets/secrets.env)."
    echo "New VM: ./forgesre install"
    echo "Existing VM: do not re-run install.sh; git pull && ./forgesre update"
    exit 1
  fi
}

run_cli_ops() {
  PYTHONPATH="$ROOT/backend:$ROOT/agents" python3 -m app.cli_ops "$(port_from_env)" "$@"
}

# Install admin from secrets.env into cookie jar $1. Password via stdin, not curl argv (ps).
admin_login() {
  printf '%s' "$FORGESRE_ADMIN_PASSWORD" | curl -fsS -c "$1" -b "$1" -X POST "http://127.0.0.1:${PORT}/login" \
    --data-urlencode "email=${FORGESRE_ADMIN_EMAIL}" --data-urlencode "password@-" >/dev/null
}

print_overview() {
  cat <<'EOF'
ForgeSRE CLI — operate the appliance from the clone directory.

Usage:
  ./forgesre                  Interactive prompt (type journal, history, …)
  ./forgesre <command> [args]
  ./forgesre help [command]
  ./f <command>               Same CLI, shorter name

Do not re-run ./install.sh on a live box. That regenerates passwords.
Existing VM after git pull:
  ./forgesre render-monitoring
  ./forgesre update
  ./forgesre doctor
  ./forgesre test
Bounce containers only (no pull, no install, secrets untouched):
  ./forgesre restart

Commands:
  help [command]     This overview, or detailed help for one command
  shell              Same prompt as ./forgesre with no args
  quit / exit        Leave the forgesre> prompt (Ctrl-D also works)
  install            Guided first-time install (new VM only)
  doctor             Short health lights (Core API, Core (container), Prometheus, …)
  test               Full appliance report (files, HTTP, login, APIs, email, logs)
  ping [asset]       ICMP + exporter /metrics (# / id / hostname / IP; alias: probe)
  probe [asset]      Same as ping
  verify [asset]     Live chain: exporter → prometheus → alertmanager → core (# / id / hostname / IP)
  status             docker compose ps
  logs [service]     Container logs (default: last 100 lines)
  config             Print config/forgesre.yml
  settings           Settings page from the shell: list, get, set, test, set-secret
  assets             List inventory with # (alias: inventory)
  inventory          Same as assets
  capacity           30-day disk / interface history of one asset, days to full
  sources            GLPI / Zabbix / NetBox / LibreNMS: last sync, linked assets, conflicts
  discovery          LibreNMS discovery: status, read now, nets CIDR..., scan
  snmp               snmp_exporter health + SNMP HTTP SD targets
  render-monitoring  Rewrite Prometheus / Alertmanager / snmp.yml / Alloy / Loki config
  snmp-auths         Write per-asset SNMP auths (Custom community / v3) into snmp.yml
  journal [module]   Internal console reports (JSON)
  demo               HighCPU first-hour path (owner mail, similar history)
  demo-rca           Filesystem RCA demo gauge (read-only)
  demo-reset         Lower demo CPU/disk gauges (stops the demo HighCPU fire)
  jobs               Background RCA job queue
  checks             Certificates, backup age, heartbeats
  slo                SLOs: availability, error budget, burn rate
  alert-quality      Noisiest alerts: acknowledged vs cleared alone, flapping, advice
  power              UPS, PDU and temperature: on battery, runtime, load, sensors
  lifecycle          Support / warranty, end of life and licences expiring or expired
  racks              Rack elevation: devices by rack and U position, overlaps
  synthetic          Synthetic checks (HTTP, TCP, DNS, ping): last result per check
  network            BGP peers, OSPF neighbours and the busiest interfaces
  handover           Shift handover: show, write "notes", take (next shift confirms)
  actions            Open follow-up actions from incident reviews, overdue first
  sla                SLA: acknowledged / resolved in time per severity
  forgeai            ForgeAI model status, last questions; with INC-… the exact prompts
  kubernetes         Kubernetes / OpenShift clusters
  incidents          Short colored board (red/yellow/green); INC-… for one row
  history            90-day incident history (filters; INC-… for mail/audit/notes)
  login              Sign in as a ForgeSRE user (engineer / analyst / …)
  logout             Forget CLI cookie (falls back to install admin)
  whoami             Print the CLI session user
  sd                 Prometheus HTTP SD (Linux) and SNMP HTTP SD
  version            Appliance version from .env
  secrets-check      Refuse-to-start defaults: SECRET_KEY / webhook token
  fetch-llm          Download a local model (Qwen3 4B, 2.5 GB, by default) and start llama.cpp
  backup             One folder per run under data/backups (tar.gz + MANIFEST; --no-secrets / --include-models)
  restore            List backup folders (newest first); apply only with --yes after stopping Core
  import             Alias for restore (numbered picker; also: import backup)
  remove             Delete one backup folder (tar + MANIFEST); confirm with --yes or typed yes
  update             Backup, render monitoring, refresh images, restart, doctor
  restart            Restart running stack containers only (no git pull, install, or secrets)
  bundle             One file with code and every image, for an appliance without internet
  mailbox            Optional Postfix/Dovecot + Roundcube (off; Core SMTP unchanged)
  tls                How to put optional HTTPS (Caddy) in front of Core
  completion         Print a `source …completion.bash` line for ~/.bashrc

Examples:
  ./forgesre                  # then: journal / incidents / quit
  ./forgesre help quit
  ./forgesre login
  incidents
  incidents INC-000012
  ./f journal
  ./forgesre help snmp
  ./forgesre ping
  ./forgesre ping win10-gp
  ./forgesre verify
  ./forgesre verify 12
  ./forgesre verify win10-gp
  ./forgesre verify DESKTOP-CG81N3J
  ./forgesre verify 10.10.10.60
  ./forgesre assets
  ./forgesre snmp
  ./forgesre jobs
  ./forgesre incidents
  ./forgesre history --days 90
  ./forgesre sd
  ./forgesre demo-reset
  ./forgesre secrets-check
  ./forgesre journal snmp
  ./forgesre logs snmp-exporter
  ./forgesre snmp-auths       # after saving a Custom community / v3 asset
  ./forgesre restart          # bounce containers, no pull / render / secrets
  ./forgesre render-monitoring && docker compose up -d
EOF
}

print_help_command() {
  local name="${1:-}"
  case "$name" in
    help)
      cat <<'EOF'
help — show CLI overview or one command.

  ./forgesre help
  ./forgesre help snmp
  ./forgesre help quit
  ./f help
EOF
      ;;
    shell)
      cat <<'EOF'
shell — prompt that stays open so you do not retype ./forgesre.

  ./forgesre
  ./forgesre shell
  ./f

Then type the full command name, not a one-letter shortcut. TAB completes
commands, compose services (logs sn<TAB> → snmp-exporter), and incident ids.

  journal
  logs snmp-exporter
  incidents INC-<TAB>
  history --days 90
  doctor
  quit
EOF
      ;;
    quit|exit)
      cat <<'EOF'
quit — leave the interactive prompt (forgesre>). Same as exit and Ctrl-D.

  ./forgesre
  forgesre> journal
  forgesre> incidents
  forgesre> quit

Inside the prompt you type only the command name (journal, doctor, test, …).
You do not type ./forgesre again. TAB completes names.

  exit      same as quit
  Ctrl-D    same as quit (end of input)

From the host bash you are already outside the prompt, so ./forgesre quit
does nothing except print this note. Open the prompt first:

  ./forgesre
  ./forgesre shell
  ./f
EOF
      ;;
    completion)
      cat <<'EOF'
completion — print a source line so TAB works in your login bash (not only inside ./forgesre).

  eval "$(./forgesre completion)"
  # or add the printed line to ~/.bashrc

Inside ./forgesre (the prompt) TAB already works without this.
EOF
      ;;
    install)
      cat <<'EOF'
install — first-time wizard. Writes .env, secrets, config, starts Compose.

  ./forgesre install
  ./forgesre install --non-interactive --profile standard --port 8080

Do NOT run this on a VM that already has secrets. Use update / render-monitoring.
EOF
      ;;
    doctor)
      cat <<'EOF'
doctor — same checks as Settings › Health. Overall HEALTHY or DEGRADED.

  ./forgesre doctor
  ./doctor.sh

Core API is curl /api/v1/health (no auth). That probe decides if Core is up.
/api/v1/system/doctor needs the webhook token only after health answers.
Core (container) is the compose service stack row (always-ok dummy, not a
second probe). Machine JSON key stays "core".

Grafana is graphs only. Down is yellow (warn), not DEGRADED, not a Journal error.
Prometheus / Alertmanager failures name the hop (:9090 / :9093), never "Prometheus Stack".

snmp: paused (no SNMP targets) when there are no Network device + IP targets — that is not DOWN.
Do not add devices just to un-pause the tile. When inventory has SNMP targets, doctor
starts snmp-exporter via compose if :9116 is dark.
NetBox: UI up + API 403 is warn (yellow), not paused. First-boot (UI down) is starting.
Core's NETBOX_API_TOKEN is a token on the NetBox superuser, not a second UI login.
Fix if snmp is truly down: docker compose up -d snmp-exporter && ./forgesre snmp

For a long written report (files, login, APIs, email config, core logs):

  ./forgesre test
EOF
      ;;
    test)
      cat <<'EOF'
test — live appliance verification with a detailed Markdown + JSON report.

  ./forgesre test
  ./test.sh
  ./forgesre test --out /tmp/forgesre-test.md

Writes data/reports/forgesre-test-<timestamp>.md and .json.
PASS / WARN / FAIL / SKIP per check. Exit 1 only when something FAILs.

Does not send mail. Does not run install.sh. doctor is the short light;
test is the long report of how each piece is probed.
EOF
      ;;
    ping|probe)
      cat <<'EOF'
ping — ICMP + exporter /metrics from this VM (alias: probe).

  ./forgesre ping
  ./forgesre ping 12
  ./forgesre ping win10-gp
  ./forgesre ping DESKTOP-CG81N3J
  ./forgesre ping 10.10.10.60
  ./forgesre ping --timeout 3
  ./forgesre ping --demo
  ./forgesre probe              # same command

No extra flags for the common case: probes assets already in ForgeSRE
(inventory / Prometheus scrape_address), skipping seeded forge-demo-* rows
and discovery seed 10.20.30.41.

Each row reports:
  ICMP    PASS/FAIL  — host answers ping (L3 only)
  METRICS PASS/FAIL  — HTTP GET /metrics
                       Linux   :9100  (node_exporter)
                       Windows :9182  (windows_exporter)
                       or the asset's configured scrape_address

Ping is not a Prometheus scrape. ICMP PASS + METRICS FAIL means the VM is
on the network but ForgeSRE cannot see it: exporter down, firewall on the
exporter port, or wrong port (Windows is 9182, not Linux 9100).
An IP with no inventory type probes both :9182 and :9100 and classifies
windows_ vs node_ metrics (same detect as Assets / Discovery).

Network devices skip HTTP and point at ./forgesre snmp (UDP/161).
Exit 1 if any METRICS/ICMP check FAILs.
EOF
      ;;

    verify)
      cat <<'EOF'
verify — live communication for inventory (not ./forgesre test).

  ./forgesre verify
  ./forgesre verify 12
  ./forgesre verify win10-gp
  ./forgesre verify DESKTOP-CG81N3J
  ./forgesre verify 10.10.10.60
  ./forgesre verify --timeout 3
  ./forgesre verify --demo

Runs on the host CLI (same as ping): Ubuntu Python must not import sqlalchemy.
Do not pip install sqlalchemy on the VM. GUI Verify still runs inside Core.

test = appliance health after update (files, compose, login, APIs).
verify = this host → ICMP / exporter or SNMP → Prometheus sees it →
Alertmanager reachable → last Core incident (SKIP if none). Optional last
RCA facts vs PromQL. LLM is listed only if ForgeAI is on; verify does not
call the LLM.

Chain: exporter → prometheus → alertmanager → core
  ICMP / PORT / FAMILY   exporter answers (:9100 node_ / :9182 windows_ / SNMP)
  PROM / TARGET / SERIES Prometheus up, scrape target health=up, family series
  AM                     Alertmanager reachable (not "an alert fired")
  CORE                   last incident/webhook; SKIP if none (no alarm is valid)

Universal classes (not SKUs):
  Linux    :9100  node_exporter / node_
  Windows  :9182  windows_exporter / windows_
  Network  SNMP UDP/161 (snmp_exporter, same path as ./forgesre snmp)
  Unknown  SKIP with a reason (no fake green host)

Missing exporter or no Prometheus target is SKIP or FAIL with an honest
reason. Seeded forge-demo-* rows and discovery seed 10.20.30.41
(disc-10-20-30-41) are lab-only (label DEMO); they are not proof of a
real scrape and are not in Prometheus HTTP SD. Default run skips them;
--demo includes them labeled. Verify does not call the LLM, even when
ForgeAI is enabled.

One number, Asset ID, hostname, or IP prints inventory ForgeSRE already knows plus live probes
(ICMP, port, metric family, Prom up, Prom target, series, Alertmanager,
Core incident, last RCA mismatch, LLM).

Exit 1 if any row FAILs. SKIP-only is exit 0.
EOF
      ;;
    status)
      cat <<'EOF'
status — docker compose ps (host networking; ports are on localhost).

  ./forgesre status
EOF
      ;;
    logs)
      cat <<'EOF'
logs — docker compose logs --tail 100.

  ./forgesre logs
  ./forgesre logs core
  ./forgesre logs snmp-exporter
  ./forgesre logs prometheus
EOF
      ;;
    settings)
      cat <<'EOF'
settings — the Settings page from the shell (Admin).

  ./forgesre settings                    all settings by group; secrets show set / NOT SET
  ./forgesre settings integrations       one group (general, network, integrations,
                                         discovery, notifications, ai)
  ./forgesre settings get ai.enabled     one setting as JSON
  ./forgesre settings set ai.enabled true
                                         change a config/forgesre.yml value (validated,
                                         audited, live at once)
  ./forgesre settings test               test every service and integration
  ./forgesre settings test zabbix        test one
  ./forgesre settings set-secret ZABBIX_API_TOKEN
                                         prompt for a token, write secrets/secrets.env,
                                         restart Core

Ports and service URLs are set by the installer in .env; change them there.
EOF
      ;;
    config)
      cat <<'EOF'
config — print config/forgesre.yml.

  ./forgesre config

After editing YAML, recreate Core:
  docker compose up -d --force-recreate core
EOF
      ;;
    assets|inventory)
      cat <<'EOF'
assets — list inventory from the Core API (login as the install admin).

  ./forgesre assets
  ./forgesre assets 12
  ./forgesre inventory          # same command

# is the stable asset number (not a row index; gaps stay after Remove).
Linux hosts with scrape_address are Prometheus node_exporter targets (:9100).
Windows Server rows use windows_exporter (:9182). Network device + IP is
snmp_exporter (UDP/161). ICMP ping is not a scrape — ./forgesre ping.

Add a switch in the UI (Assets → Add asset) or:
  # after UI login cookie, or use the form
  See docs/operator-handbook.md §6 and §7.
EOF
      ;;
    snmp)
      cat <<'EOF'
snmp — check bundled snmp_exporter and list SNMP HTTP SD targets.

  ./forgesre snmp
  ./forgesre journal snmp
  ./forgesre logs snmp-exporter

What you should see:
  - HTTP 200 from http://127.0.0.1:9116/metrics
  - JSON list from /api/v1/sd/snmp (Bearer ALERTMANAGER_WEBHOOK_TOKEN)
  - Empty JSON [] until you add a Network device with an IP

Linux node_exporter hosts are never SNMP-scraped.
snmp_exporter walks UDP/161 from this host using SNMP_COMMUNITY
(default public, stored in secrets/secrets.env). Allow UDP/161 outbound
from the ForgeSRE VM to the device; the device ACL must allow this host.

Change community, then re-render (do not re-install):

  # edit SNMP_COMMUNITY in secrets/secrets.env
  ./forgesre render-monitoring
  docker compose up -d snmp-exporter

Per asset (Assets → Edit → Comms / monitoring): SNMP v1 / v2c / v3, Default or
Custom community, v3 USM user. Custom and v3 need ./forgesre snmp-auths
(see ./forgesre help snmp-auths).

snmp.yml ships a valid snmp_exporter v0.26 if_mib module, so the exporter stays
up after update. SnmpDeviceUnreachable then means the device did not answer
(UDP/161, ACL, community or v3 user), not a broken exporter config.
EOF
      ;;
    snmp-auths)
      cat <<'EOF'
snmp-auths — write per-asset snmp_exporter auths into data/generated/snmp.yml.

Assets → Edit → Comms / monitoring stores SNMP version (v1 / v2c / v3),
Default or Custom community, and v3 USM user / auth / privacy. v2c Default
uses public_v2 and v1 Default uses public_v1 (both SNMP_COMMUNITY). A Custom
community or v3 needs its own auth (forgesre_<asset id>) in snmp.yml.
Core writes it on its own when the asset is saved (and every 5 minutes while
one is pending); this command does the same now from the shell:

  ./forgesre snmp-auths

Reads them from Core (GET /api/v1/sd/snmp-auths, Bearer webhook token),
rewrites only the forgesre-asset-auths block, chmod 600, and POSTs
snmp_exporter /-/reload. Until the auth is in snmp.yml, SNMP HTTP SD keeps
sending public_v2 and the asset page shows "pending". Secrets are never
printed. ./forgesre update and render-monitoring run this too.
EOF
      ;;
    render-monitoring)
      cat <<'EOF'
render-monitoring — regenerate generated Prometheus / Alertmanager / snmp.yml,
Alloy config.alloy, and Loki loki.yml.

Use this on an existing VM after git pull so monitoring config is current
without running ./install.sh. ./forgesre update runs it too.

  ./forgesre render-monitoring
  docker compose up -d
  ./forgesre doctor

Reads ALERTMANAGER_WEBHOOK_TOKEN and SNMP_COMMUNITY from secrets/secrets.env.
Writes $FORGESRE_DATA/generated/{prometheus,alertmanager,snmp,alerts}.yml
plus config.alloy and loki.yml (copied from logging/, no secrets).
Sets SNMP_EXPORTER_CONFIG / PROMETHEUS_ALERTS / ALLOY_CONFIG / LOKI_CONFIG
in .env if those keys are missing. Reloads snmp_exporter and Prometheus.
Recreates loki and alloy when those files changed (Alloy may POST /-/reload).

Optional extra Prometheus rules: copy monitoring/alerts.local.yml.example
to monitoring/alerts.local.yml (gitignored). It is concatenated after the
bundled alerts.yml.
EOF
      ;;
    journal)
      cat <<'EOF'
journal — internal console reports (JSON). Not Docker logs.

  ./forgesre journal
  ./forgesre journal inventory
  ./forgesre journal snmp
  ./forgesre journal demo

Modules include install, seed, inventory, discovery, snmp, incident, rca,
jobs, notification, demo. UI: /journal
EOF
      ;;
    demo)
      cat <<'EOF'
demo — first-hour HighCPU path on forge-demo-01 (demo gauge, not a real host).

  ./forgesre demo

Then: Dashboard → incident → Who to call → Escalation → Console.
EOF
      ;;
    demo-rca)
      cat <<'EOF'
demo-rca — filesystem RCA on the demo disk gauge. Read-only. Does not fill a disk.

  ./forgesre demo-rca
EOF
      ;;
    demo-reset)
      cat <<'EOF'
demo-reset — set demo CPU/disk gauges back to 12% / 35%.

Use after ./forgesre demo so HighCPU does not stay firing forever.

  ./forgesre demo-reset
EOF
      ;;
    kubernetes)
      cat <<'EOF'
kubernetes — Kubernetes / OpenShift / k3s clusters (read-only): nodes, workloads, open incidents.

Clusters are listed in config/forgesre.yml (kubernetes.clusters); each needs a token:
  ./forgesre settings set-secret K8S_TOKEN_<NAME>

  ./forgesre kubernetes          one line per cluster
  ./forgesre kubernetes sync     read every cluster now (background)
EOF
      ;;
    discovery)
      cat <<'EOF'
discovery — devices come from LibreNMS; ForgeSRE never scans a network itself.
  ./forgesre discovery            LibreNMS ready?, discovery.mode, last read, found list
  ./forgesre discovery read       read LibreNMS's devices and links now (background job)
  ./forgesre discovery nets 10.20.30.0/24 10.20.40.0/24
                                  set the ranges LibreNMS may discover (lnms config nets)
  ./forgesre discovery scan       run LibreNMS's snmp-scan on those ranges, then read
New devices wait in Inventory > Add devices > From LibreNMS (semi-automatic), or are
added at once with discovery.mode automatic.
EOF
      ;;
    sources)
      cat <<'EOF'
sources — the systems that feed the inventory (GLPI, Zabbix, NetBox, LibreNMS):
on or off, last sync, how many assets each is linked to, and the open conflicts
(a source disagrees with the inventory; nothing is overwritten until an Engineer
decides in Inventory > Sources).

  ./forgesre sources
EOF
      ;;
    capacity)
      cat <<'EOF'
capacity — about 30 days of disk use and interface receive for one asset, with
"~N days to full" when disk use keeps climbing (! marks 30 days or less).

  ./forgesre capacity web-01
  ./forgesre capacity 12 --refresh     read Prometheus / Zabbix again now

Read in the background jobs worker and cached for 15 minutes.
EOF
      ;;
    slo)
      cat <<'EOF'
slo — service level objectives: availability against target, error budget left,
burn rate over the last 24 h (1.0x = spending the budget evenly over the window).

  ./forgesre slo
EOF
      ;;
    handover)
      cat <<'EOF'
handover — the shift handover, as on the NOC page.

  ./forgesre handover                    the latest handover and whether it was taken over
  ./forgesre handover write "notes…"     hand over: notes plus the incidents still open
  ./forgesre handover take               the next shift confirms it read the latest one
EOF
      ;;
    actions)
      cat <<'EOF'
actions — follow-up actions from incident reviews that are not done yet, overdue first.

  ./forgesre actions
Add and tick them off on the incident page (Follow-up actions).
EOF
      ;;
    sla)
      cat <<'EOF'
sla — response (acknowledged in time) and resolve (resolved in time) per severity.

  ./forgesre sla        last 30 days
  ./forgesre sla 7
Targets: Settings › SLA (sla.response.*, sla.resolve.*). SLA shows on incidents and reports;
it does not change escalation.
EOF
      ;;
    lifecycle)
      cat <<'EOF'
lifecycle — support / warranty, vendor end of life and licence dates that run out soon.

  ./forgesre lifecycle

Dates are set per asset (Edit › Support: Support until, End of life, Licence expires).
Support warns the asset's own lead days ahead; end of life and licences warn
checks.lifecycle_warn_days (30) ahead. The 15-minute checks job fires AssetLifecycleExpiring
per asset and date (an expired licence is high, the rest warning).
EOF
      ;;
    network)
      cat <<'EOF'
network — routing and traffic from SNMP.

  ./forgesre network

BGP peers (BGP4-MIB) and OSPF neighbours (OSPF-MIB), problems first, from Prometheus job
forgesre-snmp-routing: Router, Firewall and Network device assets, plus any SNMP asset with
extras snmp_routing=on (snmp_routing=off opts one out). Then the ten busiest interfaces in and
out over 5 minutes (if_mib). Alerts: BgpPeerDown, OspfNeighbourLost (group forgesre-routing).
Config changes come from Oxidized (Settings › Integrations › Oxidized) as changes before incident.
EOF
      ;;
    synthetic)
      cat <<'EOF'
synthetic — black-box checks the appliance runs like a user (blackbox_exporter :9115).

  ./forgesre synthetic

One row per check: kind (http, tcp, dns, icmp), last result (ok / FAIL / ? before the first
probe), probe time and target. Add, change or remove checks in Settings › Checks › Synthetic
checks (Engineer). Prometheus job forgesre-synthetic probes every 60 s; SyntheticCheckFailed
fires after 3 minutes (critical checks), SyntheticCheckDegraded after 10 (warning checks).
If every row is "?": docker compose up -d blackbox-exporter, then ./forgesre doctor.
EOF
      ;;
    racks)
      cat <<'EOF'
racks — rack elevation: which device sits on which U, per site / row / rack.

  ./forgesre racks

Set on the asset: Location › Rack, Rack position (lowest U) and Height (U). Rack height is
inventory.rack_units (42). Devices with a rack but no position, and two devices on the same
U, are listed under the rack. Same data as Inventory › Racks.
EOF
      ;;
    power)
      cat <<'EOF'
power — UPS, PDU and environment sensors (SNMP UPS-MIB and ENTITY-SENSOR-MIB).

  ./forgesre power

One row per UPS: state, output source (normal, battery, bypass), battery status, charge,
minutes left, load, input voltage, alarms. Then temperature, humidity, voltage and current
sensors. Assets of type UPS, PDU or Environment sensor are polled by Prometheus job
forgesre-snmp-power; set extras snmp_power=on to poll any other device the same way.
Same data as NOC › Power and environment. Alert rules: monitoring/alerts.yml forgesre-power.
EOF
      ;;
    alert-quality)
      cat <<'EOF'
alert-quality — which alerts page people for nothing, noisiest first.

  ./forgesre alert-quality        last 30 days
  ./forgesre alert-quality 7      last 7 days

Per alert name: incidents, % acknowledged by a person, % that cleared by themselves within
10 minutes, flapping incidents and a suggestion (noise filter, longer for:, higher threshold,
keep). Same table as Reports › Alert quality. Storm and flapping settings: Settings › Alarms.
EOF
      ;;
    forgeai)
      cat <<'EOF'
forgeai — the local language model and what ForgeSRE asked it.

  ./forgesre forgeai              on/off, loaded model, last week, last questions
  ./forgesre forgeai docs         uploaded vendor documents and whether document search works
  ./forgesre forgeai test         ask the local model one tiny question and time it (first token, total)
  ./forgesre forgeai INC-0412     every question for that incident with the exact
                                  prompts and the model's answer word for word
  ./forgesre forgeai tuning       per incident skill: answers next to the analysts'
                                  confirmed causes, ratings, why answers were rejected
  ./forgesre forgeai tuning linux-disk   one skill

Skills (the editable instructions) are in Automation › ForgeAI skills.
EOF
      ;;
    checks)
      cat <<'EOF'
checks — TLS certificate expiry, ForgeSRE backup age and heartbeats.

Runs every 15 minutes on the appliance; failures open incidents like any alert.

  ./forgesre checks                 latest results, failing first
  ./forgesre checks run             run now (background)
  ./forgesre checks ping NAME [H]   record a heartbeat (H = expected every H hours)
EOF
      ;;
    jobs)
      cat <<'EOF'
jobs — background job queue: counts per status, then the newest jobs.

RCA, discovery scans and digests run on one worker thread; ForgeAI
rewrites on a second one, so a slow model never holds the rest.
Failed jobs show their error. Uses the ./forgesre login session,
else the install admin from secrets.env.

  ./forgesre jobs
EOF
      ;;
    secrets-check)
      cat <<'EOF'
secrets-check — verify SECRET_KEY and ALERTMANAGER_WEBHOOK_TOKEN are not shipped defaults.

Core refuses to start with those defaults unless FORGESRE_DEV=1.

  ./forgesre secrets-check
EOF
      ;;
    fetch-llm)
      cat <<'EOF'
fetch-llm — download a GGUF into $FORGESRE_DATA/models/model.gguf and start llama.cpp.

  ./forgesre fetch-llm
  ./forgesre fetch-llm --download-only
  ./forgesre fetch-llm --offline
  ./forgesre doctor          # llm: ok when :8088 answers
  ./forgesre test

Default model is Qwen3-4B Q4_K_M (2.5 GB, fast on CPU). Others:

  ./forgesre fetch-llm --model qwen3-8b       (also llama3.1-8b, qwen2.5-7b, qwen2.5-14b)

Settings › RCA / AI downloads, imports and switches models from the browser.
Any other single-file GGUF:

  FORGESRE_LLM_URL='https://huggingface.co/Qwen/Qwen3-4B-GGUF/resolve/main/Qwen3-4B-Q4_K_M.gguf' ./forgesre fetch-llm

Or wget into data/models/model.gguf, then --offline. Do not leave the file
in the clone root. Sets COMPOSE_PROFILES=ai and ai.llm.mode=bundled.

Do not re-run ./install.sh to add the model. ForgeRCA works without a GGUF.
Guide: docs/llm.md
EOF
      ;;
    bundle)
      cat <<'EOF'
bundle — everything an appliance without internet needs, in one file. Run it on a
machine with internet and Docker, in a ForgeSRE checkout:

  ./forgesre bundle                    code + every image (Core built here)
  ./forgesre bundle --include-models   also the ForgeAI model files

Writes data/bundles/forgesre-bundle-<version>-<commit>.tar. On the offline host:
  tar -xf forgesre-bundle-….tar load-bundle.sh && ./load-bundle.sh forgesre-bundle-….tar
then ./install.sh --offline (new) or ./forgesre update --offline. See docs/offline.md.
EOF
      ;;
    backup)
      cat <<'EOF'
backup — one folder per run under $FORGESRE_DATA/backups (default ./data/backups).

  ./forgesre backup
  ./forgesre backup --no-secrets
  ./forgesre backup --include-models
  ./backup.sh --no-secrets

Writes data/backups/backup_YYYYMMDDTHHMMSSZ/forgesre.tar.gz (mode 600)
plus MANIFEST.txt. The backups root has folders, not loose files.
One restore unit = the tar.gz (db dump, yml, .env, secrets, generated,
logs, examples, installation-report inside). Do not unpack it here.

Includes: Postgres/SQLite dump (users, incidents, playbooks, playrules, journal),
config/forgesre.yml, .env, secrets.env (unless --no-secrets), compressed logs,
monitoring/alerts.local.yml, data/generated/, config/examples/.

Host CLI dumps Postgres with docker compose exec postgres using the same
docker rights as ./forgesre update (docker info, else sudo). No sqlalchemy
on the host. Administration Backup uses Core, which has sqlalchemy. Same
archive format (db.json inside forgesre.tar.gz). ./forgesre backup still
exists; ./forgesre update also runs backup as a safety net.

Not included: Docker images, Prometheus/Loki/Grafana volumes, nested backups.
LLM GGUF files are skipped unless --include-models (they are often multi-GB).

The tar is mode 600; the run folder is mode 700. Administration can
create/download the same archives (admin session only). Never commit
data/backups/. Use --no-secrets when the file will leave the VM.
EOF
      ;;
    restore|import)
      cat <<'EOF'
restore — apply a platform backup. Refuses without --yes.

  ./forgesre restore
  ./forgesre import
  ./forgesre import backup
  ./forgesre restore 1
  ./forgesre restore 1 --yes
  ./forgesre restore data/backups/backup_20260824T120000Z
  ./forgesre restore data/backups/backup_20260824T120000Z/forgesre.tar.gz --yes
  ./forgesre restore data/backups/forgesre-20260824T120000Z.tar.gz --yes

With no path, lists backup_* folders (newest first) and asks for a number.
`import` and `import backup` are the same picker. Then still needs --yes.
Same inside the forgesre> prompt: restore   /   import backup

Without --yes this only prints the plan and exits 1. It will overwrite
the database, .env, secrets, and config. Stop Core first:

  docker compose stop core
  ./forgesre restore
  ./forgesre restore 1 --yes
  ./forgesre update

Each run is a folder data/backups/backup_YYYYMMDDTHHMMSSZ/ with one
forgesre.tar.gz (the import unit) and a short MANIFEST.txt. Restore
accepts the folder or the tar inside it. Legacy forgesre-*.tar.gz at
the backups root still works.

Administration Import stores an upload under data/backups/backup_…/. The Restore
dropdown (newest first, timestamp + folder name) requires typing RESTORE.
A browser restore cannot stop Core; prefer this CLI path after a crash
or when migrating VMs.
EOF
      ;;
    remove)
      cat <<'EOF'
remove — delete one backup run folder (tar.gz + MANIFEST). Refuses without --yes.

  ./forgesre remove backup
  ./forgesre remove backup 1
  ./forgesre remove backup 1 --yes
  ./forgesre remove 1 --yes

With no number, lists backup_* folders (newest first) and asks for a number.
Then confirm: type yes, or pass --yes. Deletes that folder only — never
data/ and never the whole data/backups/ directory. Legacy
data/backups/forgesre-*.tar.gz at the root can be removed the same way.

Does not restore. To apply an archive: ./forgesre restore 1 --yes
EOF
      ;;
    incidents)
      cat <<'EOF'
incidents — compact colored board from the Core API (SSH/terminal).

Red = critical / open. Yellow = investigating or warning. Green = done.

  ./forgesre incidents
  ./forgesre incidents INC-0134_16.08.2026_09:13
  incidents                 # inside ./forgesre prompt
  incidents INC-<TAB>       # complete ids (seq + date + time)

Then login as an engineer (UI user, not the Linux ssh account):

  ./forgesre login
EOF
      ;;
    login)
      cat <<'EOF'
login — store a ForgeSRE UI session for the CLI (engineer, analyst, …).

  ./forgesre login
  ./forgesre login engineer@dc.local 'password'
  ./forgesre whoami
  ./forgesre logout

This is not Linux SSH. SSH gets you onto the VM; login is the ForgeSRE role.
Cookie: data/cli.session (mode 600). Without login, CLI uses install admin
from secrets.env when that file is readable.
EOF
      ;;
    logout)
      cat <<'EOF'
logout — delete data/cli.session.

  ./forgesre logout
EOF
      ;;
    whoami)
      cat <<'EOF'
whoami — print the ForgeSRE user the CLI is calling as.

  ./forgesre whoami
EOF
      ;;
    history)
      cat <<'EOF'
history — 90-day lookback of incidents (Postgres, not Loki).
The GUI list is Incidents (/history redirects there). This command stays the CLI lookback.

  ./forgesre history
  ./forgesre history --days 90
  ./forgesre history --status CLOSED
  ./forgesre history --asset db-01
  ./forgesre history INC-000012

INC-… prints mail outbox, audit (who Ack/Resolve), and operator notes.
TAB completes ids (INC-0134_16.08.2026_09:13 and older INC-000012).
EOF
      ;;
    sd)
      cat <<'EOF'
sd — print Prometheus HTTP SD (Linux node_exporter :9100 and Windows
windows_exporter :9182) and SNMP HTTP SD.

  ./forgesre sd

Uses ALERTMANAGER_WEBHOOK_TOKEN. Empty SNMP [] is normal until a Network
device with an IP exists. Linux/Windows hosts with scrape_address appear in the
first list; they are never SNMP-scraped. Seeded forge-demo-* hosts and
discovery seed 10.20.30.41 are lab-only and do not appear in HTTP SD.
EOF
      ;;
    version)
      cat <<'EOF'
version — print FORGESRE_VERSION from .env (2.0.0 after this release).

  ./forgesre version
EOF
      ;;
    tls)
      cat <<'EOF'
tls — optional HTTPS in front of Core. Not a Compose service.

Example Caddyfile: tls/Caddyfile.example

Then set FORGESRE_COOKIE_SECURE=1 (or system.cookie_secure: true in YAML)
and recreate Core so the session cookie is Secure:

  docker compose up -d --force-recreate core

Lab default stays HTTP on the management VLAN.
EOF
      ;;
    update)
      cat <<'EOF'
update — doctor (warn ok), backup, render-monitoring, compose pull/up, doctor.

  ./forgesre update
  ./forgesre update --offline

--offline skips compose pull (lab / no egress). compose pull is also skipped when
docker-compose.yml image pins are unchanged (llama.cpp is pinned server-bNNNN,
not the daily :server tag). Core --build is skipped when Dockerfile, backend/,
agents/, and frontend/ are unchanged.
Starts default Compose services including snmp-exporter (127.0.0.1:9116),
bundled NetBox (http://127.0.0.1:8001), and bundled LibreNMS
(http://127.0.0.1:8000) for Discovery SNMP identify. First NetBox / LibreNMS
boot runs migrations and can take several minutes; doctor stays yellow until
/login answers — that is not a fake green.
Backup runs on the host without sqlalchemy. The Postgres dump uses the same
docker compose rights as this command (docker info, else sudo docker compose).
If backup fails, update prints a clear error and continues so the stack
(including snmp-exporter and NetBox) still comes up. Do not pip install sqlalchemy
on the host. Do not run ./install.sh. Use this after git pull origin main.

Lighter bounce without pull/backup/render: ./forgesre restart
EOF
      ;;
    restart)
      cat <<'EOF'
restart — restart the stack containers in place (same containers, new processes).

  ./forgesre restart

Order: Postgres (waits for pg_isready), NetBox Redis, LibreNMS MariaDB/Redis,
Prometheus, Alertmanager, snmp_exporter, Loki, Alloy, Grafana, LLM, NetBox,
LibreNMS, mailbox, then Core (waits for GET /api/v1/health). Only services that
already have a container are restarted;
profile-off services (llm, mailserver, roundcube) are skipped, not an error.
The one-shot netbox-db-init is not re-run.

Does not git pull, does not run ./install.sh, does not render monitoring,
and does not write .env or secrets/. Volumes and data/ are kept.
Exit 1 if Postgres or Core cannot be restarted or Core does not answer health.
An optional service that fails to restart is a WARN and the rest continue.

New code after git pull, changed images, or edited compose: ./forgesre update
EOF
      ;;
    mailbox)
      cat <<'EOF'
mailbox — optional on-box mail server + Roundcube (off by default).

  ./forgesre mailbox
  ./forgesre mailbox --reset
  ./forgesre mailbox --bind-core

Starts docker-mailserver and Roundcube on :8081. Does **not** change Core SMTP
(Gmail / Outlook / current YAML) unless you pass --bind-core.

Use this later, after you own a domain. Internet receive needs MX + TCP/25.
Gmail and Outlook keep working as the send path without this profile.

Do not enable this profile at install. Core SMTP stays Gmail, Outlook, or host postfix.
EOF
      ;;
    "")
      print_overview
      ;;
    *)
      echo "No detailed help for '$name'."
      echo
      print_overview
      return 1
      ;;
  esac
}

cmd_snmp() {
  need_env
  # port = Core HTTP port; code = HTTP status from snmp_exporter /metrics.
  local port code
  port="$(port_from_env)"
  load_secrets
  echo "=== snmp-exporter ==="
  code="$(curl -sS -o /tmp/forgesre-snmp-metrics.txt -w "%{http_code}" http://127.0.0.1:9116/metrics || true)"
  if [[ "${code:-}" != "200" ]] && curl -fsS -H "Authorization: Bearer ${ALERTMANAGER_WEBHOOK_TOKEN}" \
      "http://127.0.0.1:${port}/api/v1/sd/snmp" 2>/dev/null | grep -q '"targets"'; then
    echo "Targets exist and :9116 is dark — starting snmp-exporter (compose, not Zabbix)..."
    if docker info >/dev/null 2>&1; then DC=(docker compose); else DC=(sudo docker compose); fi
    "${DC[@]}" up -d snmp-exporter || true
    sleep 2
    code="$(curl -sS -o /tmp/forgesre-snmp-metrics.txt -w "%{http_code}" http://127.0.0.1:9116/metrics || true)"
  fi
  echo "GET http://127.0.0.1:9116/metrics  HTTP ${code:-down}"
  if [[ "${code:-}" != "200" ]]; then
    echo "Exporter is not up. Empty SD [] is paused, not a failure."
    echo "If you have a Network device + IP: docker compose up -d snmp-exporter"
    echo "Then: ./forgesre logs snmp-exporter"
  fi
  echo
  echo "=== SNMP HTTP SD (network devices with an IP) ==="
  curl -sS -H "Authorization: Bearer ${ALERTMANAGER_WEBHOOK_TOKEN}" \
    "http://127.0.0.1:${port}/api/v1/sd/snmp" || true
  echo
  echo
  echo "Empty list [] is normal until you add type=Network device with an IP."
  echo "Community: SNMP_COMMUNITY in secrets/secrets.env (not printed here)."
  echo "Firewall: UDP/161 from this host to the device. Discovery classifies with an SNMP GET (UDP), not TCP/161."
  echo "Alerts: SnmpDeviceUnreachable (up{job=\"forgesre-snmp\"}==0 for 2m)."
}

# Discovery is LibreNMS's. ForgeSRE never sweeps a network; LibreNMS does, with its own
# ranges (nets) and snmp-scan.py. Every docker call has a timeout.
cmd_discovery() {
  local sub="${1:-status}"
  case "$sub" in
    nets)
      shift
      if [[ $# -eq 0 ]]; then
        timeout 60 "${DC[@]}" exec -T librenms lnms config:get nets
        return
      fi
      local json="[" first=1 cidr
      for cidr in ${*//,/ }; do
        if ! python3 -c 'import ipaddress,sys; ipaddress.ip_network(sys.argv[1], strict=False)' "$cidr" 2>/dev/null; then
          echo "Not a network: $cidr (use CIDR, for example 10.20.30.0/24)" >&2
          return 2
        fi
        if [[ $first -eq 1 ]]; then first=0; else json+=","; fi
        json+="\"$cidr\""
      done
      json+="]"
      timeout 60 "${DC[@]}" exec -T librenms lnms config:set nets "$json"
      echo "LibreNMS ranges set to $json. LibreNMS adds what answers SNMP; ForgeSRE reads it every 6 hours."
      echo "Scan them now: ./forgesre discovery scan"
      ;;
    scan)
      shift
      echo "LibreNMS snmp-scan of ${*:-its configured ranges} (up to 30 minutes)..."
      timeout 1800 "${DC[@]}" exec -T --user librenms librenms /opt/librenms/snmp-scan.py "$@" || {
        echo "snmp-scan did not finish cleanly. Check: ./forgesre discovery nets ; ./forgesre logs librenms" >&2
        return 1
      }
      run_cli_ops discovery read
      ;;
    read)
      run_cli_ops discovery read
      ;;
    status)
      run_cli_ops discovery
      ;;
    *)
      echo "Usage: ./forgesre discovery [status|read|nets [CIDR ...]|scan [CIDR ...]]"
      echo "  status   where discovery stands (LibreNMS ready, mode, last read, found list)"
      echo "  read     read LibreNMS's devices now (background job)"
      echo "  nets     show or set the ranges LibreNMS discovers (lnms config nets)"
      echo "  scan     run LibreNMS's snmp-scan now, then read its devices"
      echo "ForgeSRE does not scan networks itself; LibreNMS does."
      [[ "$sub" == "help" || "$sub" == "-h" || "$sub" == "--help" ]] || return 2
      ;;
  esac
}

cmd_shell() {
  echo "ForgeSRE shell — same commands as ./forgesre, without typing ./forgesre each time."
  echo "Examples: journal    incidents    incidents INC-000012    history    doctor    quit"
  echo "TAB completes names (logs sn<TAB> → snmp-exporter, incidents INC-<TAB>). Leave with: quit  |  exit  |  Ctrl-D"
  echo
  # TAB in this process only — not the operator's login shell.
  # shellcheck disable=SC1091
  source "$ROOT/scripts/forgesre-completion.bash"
  COMP_WORDBREAKS="${COMP_WORDBREAKS//:}"
  local _c
  # Register TAB completion for every bare command name typed at forgesre>.
  for _c in ${_forgesre_cmds} quit exit logs journal help; do
    complete -F _forgesre_complete "$_c" 2>/dev/null || true
  done
  complete -F _forgesre_complete -I 2>/dev/null || true
  complete -F _forgesre_complete -E 2>/dev/null || true
  bind "set completion-ignore-case on" 2>/dev/null || true
  bind "set show-all-if-ambiguous on" 2>/dev/null || true
  # line = raw input; args = that line split into words.
  local line
  local -a args
  # Read one command per prompt and run it as ./forgesre <args> until quit / exit / EOF.
  while true; do
    if [[ -t 0 && -t 1 ]]; then
      IFS= read -e -r -p "forgesre> " line || break
    else
      IFS= read -r line || break
    fi
    # Trim leading and trailing whitespace.
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" ]] && continue
    read -r -a args <<< "$line"
    case "${args[0]:-}" in
      quit|exit)
        break
        ;;
      shell)
        echo "Already in the ForgeSRE shell."
        continue
        ;;
    esac
    FORGESRE_NOSHELL=1 "$ROOT/scripts/forgesre" "${args[@]}" || true
  done
}

if [[ -z "$cmd" ]]; then
  if [[ -z "${FORGESRE_NOSHELL:-}" && -t 0 && -t 1 ]]; then
    cmd_shell
    exit 0
  fi
  cmd="help"
fi

# Dispatch: every subcommand listed here must also be in print_overview,
# print_help_command, forgesre-completion.bash and the Administration CLI table.
case "$cmd" in
  help)
    print_help_command "${1:-}"
    ;;
  shell)
    cmd_shell
    ;;
  install) exec "$ROOT/scripts/install.sh" "$@" ;;
  doctor) exec "$ROOT/scripts/doctor.sh" "$@" ;;
  test) exec "$ROOT/scripts/test.sh" "$@" ;;
  backup) exec "$ROOT/scripts/backup.sh" "$@" ;;
  restore|import)
    need_env
    exec "$ROOT/scripts/restore.sh" "$@"
    ;;
  remove)
    need_env
    exec "$ROOT/scripts/remove.sh" "$@"
    ;;
  update) exec "$ROOT/scripts/update.sh" "$@" ;;
  restart) exec "$ROOT/scripts/restart.sh" "$@" ;;
  mailbox)
    need_env
    exec "$ROOT/scripts/mailbox.sh" "$@"
    ;;
  fetch-llm)
    exec "$ROOT/scripts/fetch-llm.sh" "$@"
    ;;
  render-monitoring)
    exec "$ROOT/scripts/render-monitoring.sh" "$@"
    ;;
  snmp-auths)
    need_env
    exec "$ROOT/scripts/render-snmp-auths.sh" "$@"
    ;;
  demo)
    need_env
    PORT="$(port_from_env)"
    load_secrets
    echo "Generating demo incident workflow..."
    jar="$(mktemp)"
    admin_login "$jar"
    curl -fsS -c "$jar" -b "$jar" -X POST "http://127.0.0.1:${PORT}/api/v1/demo"
    echo
    echo "Open the UI dashboard, then:"
    echo "  1. Asset forge-demo-01 (owner contacts + similar HighCPU history)"
    echo "  2. The new incident (Who to call = platform@forgesre.local)"
    echo "  3. /escalation for the generated owner notification"
    echo "Demo discovery candidate: 10.20.30.41 on /discovery"
    rm -f "$jar"
    ;;
  demo-rca)
    need_env
    PORT="$(port_from_env)"
    load_secrets
    echo "Generating filesystem RCA demo..."
    jar="$(mktemp)"
    admin_login "$jar"
    curl -fsS -c "$jar" -b "$jar" -X POST "http://127.0.0.1:${PORT}/api/v1/demo-rca"
    echo
    rm -f "$jar"
    ;;
  demo-reset)
    need_env
    PORT="$(port_from_env)"
    load_secrets
    jar="$(mktemp)"
    admin_login "$jar"
    curl -fsS -c "$jar" -b "$jar" -X POST "http://127.0.0.1:${PORT}/api/v1/demo-reset"
    echo
    echo "Demo gauges reset to 12% CPU / 35% disk."
    rm -f "$jar"
    ;;
  jobs)
    need_env
    run_cli_ops jobs "$@"
    ;;
  checks)
    need_env
    run_cli_ops checks "$@"
    ;;
  slo)
    need_env
    run_cli_ops slo "$@"
    ;;
  alert-quality)
    need_env
    run_cli_ops alert-quality "$@"
    ;;
  power)
    need_env
    run_cli_ops power "$@"
    ;;
  lifecycle|racks|synthetic|network)
    need_env
    run_cli_ops "$cmd" "$@"
    ;;
  handover|actions|sla)
    need_env
    run_cli_ops "$cmd" "$@"
    ;;
  forgeai)
    need_env
    run_cli_ops forgeai "$@"
    ;;
  bundle)
    exec "$ROOT/scripts/bundle.sh" "$@"
    ;;
  capacity)
    need_env
    run_cli_ops capacity "$@"
    ;;
  sources)
    need_env
    run_cli_ops sources "$@"
    ;;
  discovery)
    need_env
    cmd_discovery "$@"
    ;;
  kubernetes)
    need_env
    run_cli_ops kubernetes "$@"
    ;;
  secrets-check)
    need_env
    load_secrets
    # Becomes 1 if any secret is still a shipped default; used as the exit code.
    fail=0
    if [[ "${SECRET_KEY:-}" == "forgesre-dev-secret-change-me" || -z "${SECRET_KEY:-}" ]]; then
      echo "SECRET_KEY is the shipped default — Core will refuse to start without FORGESRE_DEV=1."
      fail=1
    else
      echo "SECRET_KEY: set"
    fi
    if [[ "${ALERTMANAGER_WEBHOOK_TOKEN:-}" == "forgesre-dev-webhook-token" || "${ALERTMANAGER_WEBHOOK_TOKEN:-}" == "CHANGE-ME-RENDER-MONITORING" || -z "${ALERTMANAGER_WEBHOOK_TOKEN:-}" ]]; then
      echo "ALERTMANAGER_WEBHOOK_TOKEN is a shipped placeholder — HTTP SD and doctor will be unsafe/broken."
      fail=1
    else
      echo "ALERTMANAGER_WEBHOOK_TOKEN: set"
    fi
    exit "$fail"
    ;;
  status)
    "${DC[@]}" ps
    ;;
  logs)
    "${DC[@]}" logs --tail 100 "$@"
    ;;
  journal)
    need_env
    PORT="$(port_from_env)"
    load_secrets
    # module = optional Journal filter (snmp, rca, …); jar = temp cookie file for the admin login.
    module="${1:-}"
    jar="$(mktemp)"
    admin_login "$jar"
    if [[ -n "$module" ]]; then
      curl -fsS -c "$jar" -b "$jar" "http://127.0.0.1:${PORT}/api/v1/journal?module=${module}&limit=50"
    else
      curl -fsS -c "$jar" -b "$jar" "http://127.0.0.1:${PORT}/api/v1/journal?limit=50"
    fi
    echo
    rm -f "$jar"
    ;;
  config)
    cat config/forgesre.yml
    ;;
  settings)
    need_env
    if [[ "${1:-}" == "set-secret" ]]; then
      key="${2:-}"
      [[ -n "$key" ]] || { echo "usage: ./forgesre settings set-secret KEY" >&2; exit 2; }
      if [[ -t 0 ]]; then read -r -s -p "New value for $key: " value; echo; else read -r value; fi
      printf '%s\n' "$value" | run_cli_ops set-secret "$key" "$ROOT/secrets/secrets.env"
      unset value
      echo "Saved $key in secrets/secrets.env. Restarting Core so it reads the new value."
      docker compose up -d --force-recreate core
    else
      run_cli_ops settings "$@"
    fi
    ;;
  assets|inventory)
    need_env
    run_cli_ops assets "$@"
    ;;
  snmp)
    cmd_snmp
    ;;
  ping|probe)
    need_env
    run_cli_ops ping "$@"
    ;;
  verify)
    need_env
    run_cli_ops verify "$@"
    ;;
  incidents)
    need_env
    run_cli_ops incidents "$@"
    ;;
  history)
    need_env
    run_cli_ops history "$@"
    ;;
  login)
    need_env
    if [[ $# -ge 2 ]]; then
      FORGESRE_CLI_PASSWORD="$2" run_cli_ops login "$1"
    elif [[ -n "${FORGESRE_CLI_EMAIL:-}" && -n "${FORGESRE_CLI_PASSWORD:-}" ]]; then
      FORGESRE_CLI_PASSWORD="$FORGESRE_CLI_PASSWORD" run_cli_ops login "$FORGESRE_CLI_EMAIL"
    else
      if [[ ! -t 0 ]]; then
        echo "usage: ./forgesre login EMAIL PASSWORD"
        exit 1
      fi
      read -r -p "ForgeSRE email: " email
      read -r -s -p "Password: " password
      echo
      FORGESRE_CLI_PASSWORD="$password" run_cli_ops login "$email"
    fi
    ;;
  logout)
    PYTHONPATH="$ROOT/backend:$ROOT/agents" python3 -m app.cli_ops 0 logout
    ;;
  whoami)
    need_env
    run_cli_ops whoami
    ;;
  completion)
    echo "source \"$ROOT/scripts/forgesre-completion.bash\""
    ;;
  sd)
    need_env
    PORT="$(port_from_env)"
    load_secrets
    echo "=== Linux node_exporter / Windows windows_exporter HTTP SD ==="
    curl -sS -H "Authorization: Bearer ${ALERTMANAGER_WEBHOOK_TOKEN}" \
      "http://127.0.0.1:${PORT}/api/v1/sd/prometheus" || true
    echo
    echo
    echo "=== SNMP HTTP SD ==="
    curl -sS -H "Authorization: Bearer ${ALERTMANAGER_WEBHOOK_TOKEN}" \
      "http://127.0.0.1:${PORT}/api/v1/sd/snmp" || true
    echo
    ;;
  version)
    if [[ -f .env ]] && grep -q '^FORGESRE_VERSION=' .env; then
      awk -F= '/^FORGESRE_VERSION=/ {print $2}' .env | tail -1 | tr -d '"'
    else
      echo "2.0.0"
    fi
    ;;
  tls)
    print_help_command tls
    ;;
  quit|exit)
    print_help_command quit
    ;;
  *)
    echo "Unknown command: $cmd"
    echo
    print_overview
    exit 1
    ;;
esac
