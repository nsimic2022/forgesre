#!/usr/bin/env bash
# ForgeSRE host CLI. Run from the clone directory: ./forgesre <command>
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

cmd="${1:-}"
shift || true

if docker info >/dev/null 2>&1; then DC=(docker compose); else DC=(sudo docker compose); fi

port_from_env() {
  local port="8080"
  if [[ -f .env ]]; then
    port="$(awk -F= '/FORGESRE_HTTP_PORT/ {print $2}' .env | tail -1 | tr -d '"' || true)"
  fi
  echo "${port:-8080}"
}

need_env() {
  if [[ ! -f .env || ! -f secrets/secrets.env ]]; then
    echo "This command needs an installed appliance (.env and secrets/secrets.env)."
    echo "New VM: ./forgesre install"
    echo "Existing VM: do not re-run install.sh; git pull && ./forgesre update"
    exit 1
  fi
}

run_cli_ops() {
  PYTHONPATH="$ROOT/backend" python3 -m app.cli_ops "$(port_from_env)" "$@"
}

print_overview() {
  cat <<'EOF'
ForgeSRE CLI — operate the appliance from the clone directory.

Usage:
  ./forgesre                  Interactive prompt (type journal, history, …)
  ./forgesre <command> [args]
  ./forgesre help [command]
  ./f <command>               Same CLI, shorter name

Do not re-run ./install.sh on a live box. That regenerates passwords.
Existing VM after git pull:
  ./forgesre render-monitoring
  ./forgesre update
  ./forgesre doctor
  ./forgesre test

Commands:
  help [command]     This overview, or detailed help for one command
  shell              Same prompt as ./forgesre with no args
  quit / exit        Leave the forgesre> prompt (Ctrl-D also works)
  install            Guided first-time install (new VM only)
  doctor             Short health lights (Core API, Core (container), Prometheus, …)
  test               Full appliance report (files, HTTP, login, APIs, email, logs)
  ping [asset]       ICMP + exporter /metrics (number, id, hostname, IP; alias: probe)
  probe [asset]      Same as ping
  verify [asset]     Live chain: exporter → prometheus → alertmanager → core
  status             docker compose ps
  logs [service]     Container logs (default: last 100 lines)
  config             Print config/forgesre.yml
  assets             List inventory with # (alias: inventory)
  snmp               snmp_exporter health + SNMP HTTP SD targets
  render-monitoring  Rewrite Prometheus / Alertmanager / snmp.yml from templates
  journal [module]   Internal console reports (JSON)
  demo               HighCPU first-hour path (owner mail, similar history)
  demo-rca           Filesystem RCA demo gauge (read-only)
  demo-reset         Lower demo CPU/disk gauges (stops the demo HighCPU fire)
  jobs               Background RCA job queue
  incidents          Short colored board (red/yellow/green); INC-… for one row
  history            90-day incident history (filters; INC-… for mail/audit/notes)
  login              Sign in as a ForgeSRE user (engineer / analyst / …)
  logout             Forget CLI cookie (falls back to install admin)
  whoami             Print the CLI session user
  sd                 Prometheus HTTP SD (Linux) and SNMP HTTP SD
  version            Appliance version from .env
  secrets-check      Refuse-to-start defaults: SECRET_KEY / webhook token
  fetch-llm          Download Qwen 14B GGUF (~9 GB, not in git) and start llama.cpp
  backup             One folder per run under data/backups (tar.gz + MANIFEST; --no-secrets / --include-models)
  restore            List backup folders (newest first); apply only with --yes after stopping Core
  import             Alias for restore (numbered picker; also: import backup)
  remove             Delete one backup folder (tar + MANIFEST); confirm with --yes or typed yes
  update             Backup, render monitoring, refresh images, restart, doctor
  mailbox            Optional Postfix/Dovecot + Roundcube (off; Core SMTP unchanged)
  completion         Print a `source …completion.bash` line for ~/.bashrc

Examples:
  ./forgesre                  # then: journal / incidents / quit
  ./forgesre help quit
  ./forgesre login
  incidents
  incidents INC-000012
  ./f journal
  ./forgesre help snmp
  ./forgesre ping
  ./forgesre ping win-01
  ./forgesre verify
  ./forgesre verify 12
  ./forgesre verify win-01
  ./forgesre assets
  ./forgesre snmp
  ./forgesre jobs
  ./forgesre incidents
  ./forgesre history --days 90
  ./forgesre sd
  ./forgesre demo-reset
  ./forgesre secrets-check
  ./forgesre journal snmp
  ./forgesre logs snmp-exporter
  ./forgesre render-monitoring && docker compose up -d
EOF
}

print_help_command() {
  local name="${1:-}"
  case "$name" in
    help)
      cat <<'EOF'
help — show CLI overview or one command.

  ./forgesre help
  ./forgesre help snmp
  ./forgesre help quit
  ./f help
EOF
      ;;
    shell)
      cat <<'EOF'
shell — prompt that stays open so you do not retype ./forgesre.

  ./forgesre
  ./forgesre shell
  ./f

Then type the full command name, not a one-letter shortcut. TAB completes
commands, compose services (logs sn<TAB> → snmp-exporter), and incident ids.

  journal
  logs snmp-exporter
  incidents INC-<TAB>
  history --days 90
  doctor
  quit
EOF
      ;;
    quit|exit)
      cat <<'EOF'
quit — leave the interactive prompt (forgesre>). Same as exit and Ctrl-D.

  ./forgesre
  forgesre> journal
  forgesre> incidents
  forgesre> quit

Inside the prompt you type only the command name (journal, doctor, test, …).
You do not type ./forgesre again. TAB completes names.

  exit      same as quit
  Ctrl-D    same as quit (end of input)

From the host bash you are already outside the prompt, so ./forgesre quit
does nothing except print this note. Open the prompt first:

  ./forgesre
  ./forgesre shell
  ./f
EOF
      ;;
    completion)
      cat <<'EOF'
completion — print a source line so TAB works in your login bash (not only inside ./forgesre).

  eval "$(./forgesre completion)"
  # or add the printed line to ~/.bashrc

Inside ./forgesre (the prompt) TAB already works without this.
EOF
      ;;
    install)
      cat <<'EOF'
install — first-time wizard. Writes .env, secrets, config, starts Compose.

  ./forgesre install
  ./forgesre install --non-interactive --profile standard --port 8080

Do NOT run this on a VM that already has secrets. Use update / render-monitoring.
EOF
      ;;
    doctor)
      cat <<'EOF'
doctor — same checks as /health-ui. Overall HEALTHY or DEGRADED.

  ./forgesre doctor
  ./doctor.sh

Core API is curl /api/v1/health. Core (container) is the compose service stack
row (always-ok dummy, not a second probe). Machine JSON key stays "core".

snmp: paused (yellow) when there are no Network device + IP targets — that is not DOWN.
When inventory has SNMP targets, doctor starts snmp-exporter via compose if :9116 is dark.
Fix if it is truly down: docker compose up -d snmp-exporter && ./forgesre snmp

For a long written report (files, login, APIs, email config, core logs):

  ./forgesre test
EOF
      ;;
    test)
      cat <<'EOF'
test — live appliance verification with a detailed Markdown + JSON report.

  ./forgesre test
  ./test.sh
  ./forgesre test --out /tmp/forgesre-test.md

Writes data/reports/forgesre-test-<timestamp>.md and .json.
PASS / WARN / FAIL / SKIP per check. Exit 1 only when something FAILs.

Does not send mail. Does not run install.sh. doctor is the short light;
test is the long report of how each piece is probed.
EOF
      ;;
    ping|probe)
      cat <<'EOF'
ping — ICMP + exporter /metrics from this VM (alias: probe).

  ./forgesre ping
  ./forgesre ping win-01
  ./forgesre ping 10.10.10.60
  ./forgesre ping --timeout 3
  ./forgesre ping --demo
  ./forgesre probe              # same command

No extra flags for the common case: probes assets already in ForgeSRE
(inventory / Prometheus scrape_address), skipping seeded forge-demo-* rows
and discovery seed 10.20.30.41.

Each row reports:
  ICMP    PASS/FAIL  — host answers ping (L3 only)
  METRICS PASS/FAIL  — HTTP GET /metrics
                       Linux   :9100  (node_exporter)
                       Windows :9182  (windows_exporter)
                       or the asset's configured scrape_address

Ping is not a Prometheus scrape. ICMP PASS + METRICS FAIL means the VM is
on the network but ForgeSRE cannot see it: exporter down, firewall on the
exporter port, or wrong port (Windows is 9182, not Linux 9100).
An IP with no inventory type probes both :9182 and :9100 and classifies
windows_ vs node_ metrics (same detect as Assets / Discovery).

Network devices skip HTTP and point at ./forgesre snmp (UDP/161).
Exit 1 if any METRICS/ICMP check FAILs.
EOF
      ;;

    verify)
      cat <<'EOF'
verify — live communication for inventory (not ./forgesre test).

  ./forgesre verify
  ./forgesre verify 12
  ./forgesre verify win-01
  ./forgesre verify --timeout 3
  ./forgesre verify --demo

Runs on the host CLI (same as ping): Ubuntu Python must not import sqlalchemy.
Do not pip install sqlalchemy on the VM. GUI Verify still runs inside Core.

test = appliance health after update (files, compose, login, APIs).
verify = this host → ICMP / exporter or SNMP → Prometheus sees it →
Alertmanager reachable → last Core incident (SKIP if none). Optional last
RCA facts vs PromQL. LLM is listed only if ForgeAI is on; verify does not
call the LLM.

Chain: exporter → prometheus → alertmanager → core
  ICMP / PORT / FAMILY   exporter answers (:9100 node_ / :9182 windows_ / SNMP)
  PROM / TARGET / SERIES Prometheus up, scrape target health=up, family series
  AM                     Alertmanager reachable (not "an alert fired")
  CORE                   last incident/webhook; SKIP if none (no alarm is valid)

Universal classes (not SKUs):
  Linux    :9100  node_exporter / node_
  Windows  :9182  windows_exporter / windows_
  Network  SNMP UDP/161 (snmp_exporter, same path as ./forgesre snmp)
  Unknown  SKIP with a reason (no fake green host)

Missing exporter or no Prometheus target is SKIP or FAIL with an honest
reason. Seeded forge-demo-* rows and discovery seed 10.20.30.41
(disc-10-20-30-41) are lab-only (label DEMO); they are not proof of a
real scrape and are not in Prometheus HTTP SD. Default run skips them;
--demo includes them labeled. Verify does not call the LLM, even when
ForgeAI is enabled.

One name or id prints inventory ForgeSRE already knows plus live probes
(ICMP, port, metric family, Prom up, Prom target, series, Alertmanager,
Core incident, last RCA mismatch, LLM).

Exit 1 if any row FAILs. SKIP-only is exit 0.
EOF
      ;;
    status)
      cat <<'EOF'
status — docker compose ps (host networking; ports are on localhost).

  ./forgesre status
EOF
      ;;
    logs)
      cat <<'EOF'
logs — docker compose logs --tail 100.

  ./forgesre logs
  ./forgesre logs core
  ./forgesre logs snmp-exporter
  ./forgesre logs prometheus
EOF
      ;;
    config)
      cat <<'EOF'
config — print the first 160 lines of config/forgesre.yml.

  ./forgesre config

After editing YAML, recreate Core:
  docker compose up -d --force-recreate core
EOF
      ;;
    assets|inventory)
      cat <<'EOF'
assets — list inventory from the Core API (login as the install admin).

  ./forgesre assets
  ./forgesre assets 12
  ./forgesre inventory          # same command

# is the stable asset number (not a row index; gaps stay after Remove).
Linux hosts with scrape_address are Prometheus node_exporter targets (:9100).
Windows Server rows use windows_exporter (:9182). Network device + IP is
snmp_exporter (UDP/161). ICMP ping is not a scrape — ./forgesre ping.

Add a switch in the UI (Assets → Add asset) or:
  # after UI login cookie, or use the form
  See docs/operator-handbook.md §6 and §7.
EOF
      ;;
    snmp)
      cat <<'EOF'
snmp — check bundled snmp_exporter and list SNMP HTTP SD targets.

  ./forgesre snmp
  ./forgesre journal snmp
  ./forgesre logs snmp-exporter

What you should see:
  - HTTP 200 from http://127.0.0.1:9116/metrics
  - JSON list from /api/v1/sd/snmp (Bearer ALERTMANAGER_WEBHOOK_TOKEN)
  - Empty JSON [] until you add a Network device with an IP

Linux node_exporter hosts are never SNMP-scraped.
snmp_exporter walks UDP/161 from this host using SNMP_COMMUNITY
(default public, stored in secrets/secrets.env). Allow UDP/161 outbound
from the ForgeSRE VM to the device; the device ACL must allow this host.

Change community, then re-render (do not re-install):

  # edit SNMP_COMMUNITY in secrets/secrets.env
  ./forgesre render-monitoring
  docker compose up -d snmp-exporter
EOF
      ;;
    render-monitoring)
      cat <<'EOF'
render-monitoring — regenerate generated Prometheus / Alertmanager / snmp.yml.

Use this on an existing VM after git pull so the new forgesre-snmp job appears
without running ./install.sh.

  ./forgesre render-monitoring
  docker compose up -d
  ./forgesre doctor

Reads ALERTMANAGER_WEBHOOK_TOKEN and SNMP_COMMUNITY from secrets/secrets.env.
Writes $FORGESRE_DATA/generated/{prometheus,alertmanager,snmp,alerts}.yml
and sets SNMP_EXPORTER_CONFIG / PROMETHEUS_ALERTS in .env if missing.

Optional extra Prometheus rules: copy monitoring/alerts.local.yml.example
to monitoring/alerts.local.yml (gitignored). It is concatenated after the
bundled alerts.yml.
EOF
      ;;
    journal)
      cat <<'EOF'
journal — internal console reports (JSON). Not Docker logs.

  ./forgesre journal
  ./forgesre journal inventory
  ./forgesre journal snmp
  ./forgesre journal demo

Modules include install, seed, inventory, discovery, snmp, incident, rca,
jobs, notification, demo. UI: /journal
EOF
      ;;
    demo)
      cat <<'EOF'
demo — first-hour HighCPU path on forge-demo-01 (demo gauge, not a real host).

  ./forgesre demo

Then: Dashboard → incident → Who to call → Escalation → Console.
EOF
      ;;
    demo-rca)
      cat <<'EOF'
demo-rca — filesystem RCA on the demo disk gauge. Read-only. Does not fill a disk.

  ./forgesre demo-rca
EOF
      ;;
    demo-reset)
      cat <<'EOF'
demo-reset — set demo CPU/disk gauges back to 12% / 35%.

Use after ./forgesre demo so HighCPU does not stay firing forever.

  ./forgesre demo-reset
EOF
      ;;
    jobs)
      cat <<'EOF'
jobs — list background RCA jobs (pending / running / done / error).

Alertmanager webhooks enqueue investigate; a worker thread runs them
so the webhook does not wait on the LLM.

  ./forgesre jobs
EOF
      ;;
    secrets-check)
      cat <<'EOF'
secrets-check — verify SECRET_KEY and ALERTMANAGER_WEBHOOK_TOKEN are not shipped defaults.

Core refuses to start with those defaults unless FORGESRE_DEV=1.

  ./forgesre secrets-check
EOF
      ;;
    fetch-llm)
      cat <<'EOF'
fetch-llm — download a GGUF into $FORGESRE_DATA/models/model.gguf and start llama.cpp.

  ./forgesre fetch-llm
  ./forgesre fetch-llm --download-only
  ./forgesre fetch-llm --offline
  ./forgesre doctor          # llm: ok when :8088 answers
  ./forgesre test

Default file is Qwen2.5-14B-Instruct Q4_K_M (~9 GB). Override:

  FORGESRE_LLM_URL='https://huggingface.co/Qwen/Qwen3-4B-GGUF/resolve/main/Qwen3-4B-Q4_K_M.gguf' ./forgesre fetch-llm

Or wget into data/models/model.gguf, then --offline. Do not leave the file
in the clone root. Sets COMPOSE_PROFILES=ai and ai.llm.mode=bundled.

Do not re-run ./install.sh to add the model. ForgeRCA works without a GGUF.
Guide: docs/llm.md
EOF
      ;;
    backup)
      cat <<'EOF'
backup — one folder per run under $FORGESRE_DATA/backups (default ./data/backups).

  ./forgesre backup
  ./forgesre backup --no-secrets
  ./forgesre backup --include-models
  ./backup.sh --no-secrets

Writes data/backups/backup_YYYYMMDDTHHMMSSZ/forgesre.tar.gz (mode 600)
plus MANIFEST.txt. The backups root has folders, not loose files.
One restore unit = the tar.gz (db dump, yml, .env, secrets, generated,
logs, examples, installation-report inside). Do not unpack it here.

Includes: Postgres/SQLite dump (users, incidents, playbooks, playrules, journal),
config/forgesre.yml, .env, secrets.env (unless --no-secrets), compressed logs,
monitoring/alerts.local.yml, data/generated/, config/examples/.

Host CLI dumps Postgres with docker compose exec postgres using the same
docker rights as ./forgesre update (docker info, else sudo). No sqlalchemy
on the host. Administration Backup uses Core, which has sqlalchemy. Same
archive format (db.json inside forgesre.tar.gz). ./forgesre backup still
exists; ./forgesre update also runs backup as a safety net.

Not included: Docker images, Prometheus/Loki/Grafana volumes, nested backups.
LLM GGUF files are skipped unless --include-models (they are often multi-GB).

The tar is mode 600; the run folder is mode 700. Administration can
create/download the same archives (admin session only). Never commit
data/backups/. Use --no-secrets when the file will leave the VM.
EOF
      ;;
    restore|import)
      cat <<'EOF'
restore — apply a platform backup. Refuses without --yes.

  ./forgesre restore
  ./forgesre import
  ./forgesre import backup
  ./forgesre restore 1
  ./forgesre restore 1 --yes
  ./forgesre restore data/backups/backup_20260824T120000Z
  ./forgesre restore data/backups/backup_20260824T120000Z/forgesre.tar.gz --yes
  ./forgesre restore data/backups/forgesre-20260824T120000Z.tar.gz --yes

With no path, lists backup_* folders (newest first) and asks for a number.
`import` and `import backup` are the same picker. Then still needs --yes.
Same inside the forgesre> prompt: restore   /   import backup

Without --yes this only prints the plan and exits 1. It will overwrite
the database, .env, secrets, and config. Stop Core first:

  docker compose stop core
  ./forgesre restore
  ./forgesre restore 1 --yes
  ./forgesre update

Each run is a folder data/backups/backup_YYYYMMDDTHHMMSSZ/ with one
forgesre.tar.gz (the import unit) and a short MANIFEST.txt. Restore
accepts the folder or the tar inside it. Legacy forgesre-*.tar.gz at
the backups root still works.

Administration Import stores an upload under data/backups/backup_…/. The Restore
dropdown (newest first, timestamp + folder name) requires typing RESTORE.
A browser restore cannot stop Core; prefer this CLI path after a crash
or when migrating VMs.
EOF
      ;;
    remove)
      cat <<'EOF'
remove — delete one backup run folder (tar.gz + MANIFEST). Refuses without --yes.

  ./forgesre remove backup
  ./forgesre remove backup 1
  ./forgesre remove backup 1 --yes
  ./forgesre remove 1 --yes

With no number, lists backup_* folders (newest first) and asks for a number.
Then confirm: type yes, or pass --yes. Deletes that folder only — never
data/ and never the whole data/backups/ directory. Legacy
data/backups/forgesre-*.tar.gz at the root can be removed the same way.

Does not restore. To apply an archive: ./forgesre restore 1 --yes
EOF
      ;;
    incidents)
      cat <<'EOF'
incidents — compact colored board from the Core API (SSH/terminal).

Red = critical / open. Yellow = investigating or warning. Green = done.

  ./forgesre incidents
  ./forgesre incidents INC-0134_16.08.2026_09:13
  incidents                 # inside ./forgesre prompt
  incidents INC-<TAB>       # complete ids (seq + date + time)

Then login as an engineer (UI user, not the Linux ssh account):

  ./forgesre login
EOF
      ;;
    login)
      cat <<'EOF'
login — store a ForgeSRE UI session for the CLI (engineer, analyst, …).

  ./forgesre login
  ./forgesre login engineer@dc.local 'password'
  ./forgesre whoami
  ./forgesre logout

This is not Linux SSH. SSH gets you onto the VM; login is the ForgeSRE role.
Cookie: data/cli.session (mode 600). Without login, CLI uses install admin
from secrets.env when that file is readable.
EOF
      ;;
    logout)
      cat <<'EOF'
logout — delete data/cli.session.

  ./forgesre logout
EOF
      ;;
    whoami)
      cat <<'EOF'
whoami — print the ForgeSRE user the CLI is calling as.

  ./forgesre whoami
EOF
      ;;
    history)
      cat <<'EOF'
history — 90-day lookback of incidents (Postgres, not Loki).

  ./forgesre history
  ./forgesre history --days 90
  ./forgesre history --status CLOSED
  ./forgesre history --asset db-01
  ./forgesre history INC-000012

INC-… prints mail outbox, audit (who Ack/Resolve), and operator notes.
TAB completes ids (INC-0134_16.08.2026_09:13 and older INC-000012).
EOF
      ;;
    sd)
      cat <<'EOF'
sd — print Prometheus HTTP SD (Linux node_exporter :9100 and Windows
windows_exporter :9182) and SNMP HTTP SD.

  ./forgesre sd

Uses ALERTMANAGER_WEBHOOK_TOKEN. Empty SNMP [] is normal until a Network
device with an IP exists. Linux/Windows hosts with scrape_address appear in the
first list; they are never SNMP-scraped. Seeded forge-demo-* hosts and
discovery seed 10.20.30.41 are lab-only and do not appear in HTTP SD.
EOF
      ;;
    version)
      cat <<'EOF'
version — print FORGESRE_VERSION from .env (0.7.0 after this release).

  ./forgesre version
EOF
      ;;
    tls)
      cat <<'EOF'
tls — optional HTTPS in front of Core. Not a Compose service.

Example Caddyfile: tls/Caddyfile.example

Then set FORGESRE_COOKIE_SECURE=1 (or system.cookie_secure: true in YAML)
and recreate Core so the session cookie is Secure:

  docker compose up -d --force-recreate core

Lab default stays HTTP on the management VLAN.
EOF
      ;;
    update)
      cat <<'EOF'
update — doctor (warn ok), backup, render-monitoring, compose pull/up, doctor.

  ./forgesre update
  ./forgesre update --offline

Starts default Compose services including snmp-exporter (127.0.0.1:9116).
Backup runs on the host without sqlalchemy. The Postgres dump uses the same
docker compose rights as this command (docker info, else sudo docker compose).
If backup fails, update prints a clear error and continues so the stack
(including snmp-exporter) still comes up. Do not pip install sqlalchemy
on the host. Do not run ./install.sh. Use this after git pull origin main.
EOF
      ;;
    mailbox)
      cat <<'EOF'
mailbox — optional on-box mail server + Roundcube (off by default).

  ./forgesre mailbox
  ./forgesre mailbox --reset
  ./forgesre mailbox --bind-core

Starts docker-mailserver and Roundcube on :8081. Does **not** change Core SMTP
(Gmail / Outlook / current YAML) unless you pass --bind-core.

Use this later, after you own a domain. Internet receive needs MX + TCP/25.
Gmail and Outlook keep working as the send path without this profile.

Do not enable this profile at install. Core SMTP stays Gmail, Outlook, or host postfix.
EOF
      ;;
    "")
      print_overview
      ;;
    *)
      echo "No detailed help for '$name'."
      echo
      print_overview
      return 1
      ;;
  esac
}

cmd_snmp() {
  need_env
  local port code
  port="$(port_from_env)"
  # shellcheck disable=SC1091
  source secrets/secrets.env
  echo "=== snmp-exporter ==="
  code="$(curl -sS -o /tmp/forgesre-snmp-metrics.txt -w "%{http_code}" http://127.0.0.1:9116/metrics || true)"
  if [[ "${code:-}" != "200" ]] && curl -fsS -H "Authorization: Bearer ${ALERTMANAGER_WEBHOOK_TOKEN}" \
      "http://127.0.0.1:${port}/api/v1/sd/snmp" 2>/dev/null | grep -q '"targets"'; then
    echo "Targets exist and :9116 is dark — starting snmp-exporter (compose, not Zabbix)..."
    if docker info >/dev/null 2>&1; then DC=(docker compose); else DC=(sudo docker compose); fi
    "${DC[@]}" up -d snmp-exporter || true
    sleep 2
    code="$(curl -sS -o /tmp/forgesre-snmp-metrics.txt -w "%{http_code}" http://127.0.0.1:9116/metrics || true)"
  fi
  echo "GET http://127.0.0.1:9116/metrics  HTTP ${code:-down}"
  if [[ "${code:-}" != "200" ]]; then
    echo "Exporter is not up. Empty SD [] is paused, not a failure."
    echo "If you have a Network device + IP: docker compose up -d snmp-exporter"
    echo "Then: ./forgesre logs snmp-exporter"
  fi
  echo
  echo "=== SNMP HTTP SD (network devices with an IP) ==="
  curl -sS -H "Authorization: Bearer ${ALERTMANAGER_WEBHOOK_TOKEN}" \
    "http://127.0.0.1:${port}/api/v1/sd/snmp" || true
  echo
  echo
  echo "Empty list [] is normal until you add type=Network device with an IP."
  echo "Community: SNMP_COMMUNITY in secrets/secrets.env (not printed here)."
  echo "Firewall: UDP/161 from this host to the device. Discovery classifies with an SNMP GET (UDP), not TCP/161."
  echo "Alerts: SnmpDeviceUnreachable (up{job=\"forgesre-snmp\"}==0 for 2m)."
}

cmd_shell() {
  echo "ForgeSRE shell — same commands as ./forgesre, without typing ./forgesre each time."
  echo "Examples: journal    incidents    incidents INC-000012    history    doctor    quit"
  echo "TAB completes names (logs sn<TAB> → snmp-exporter, incidents INC-<TAB>). Leave with: quit  |  exit  |  Ctrl-D"
  echo
  # TAB in this process only — not the operator's login shell.
  # shellcheck disable=SC1091
  source "$ROOT/scripts/forgesre-completion.bash"
  COMP_WORDBREAKS="${COMP_WORDBREAKS//:}"
  local _c
  for _c in ${_forgesre_cmds} quit exit logs journal help; do
    complete -F _forgesre_complete "$_c" 2>/dev/null || true
  done
  complete -F _forgesre_complete -I 2>/dev/null || true
  complete -F _forgesre_complete -E 2>/dev/null || true
  bind "set completion-ignore-case on" 2>/dev/null || true
  bind "set show-all-if-ambiguous on" 2>/dev/null || true
  local line
  local -a args
  while true; do
    if [[ -t 0 && -t 1 ]]; then
      IFS= read -e -r -p "forgesre> " line || break
    else
      IFS= read -r line || break
    fi
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" ]] && continue
    read -r -a args <<< "$line"
    case "${args[0]:-}" in
      quit|exit)
        break
        ;;
      shell)
        echo "Already in the ForgeSRE shell."
        continue
        ;;
    esac
    FORGESRE_NOSHELL=1 "$ROOT/scripts/forgesre" "${args[@]}" || true
  done
}

if [[ -z "$cmd" ]]; then
  if [[ -z "${FORGESRE_NOSHELL:-}" && -t 0 && -t 1 ]]; then
    cmd_shell
    exit 0
  fi
  cmd="help"
fi

case "$cmd" in
  help)
    print_help_command "${1:-}"
    ;;
  shell)
    cmd_shell
    ;;
  install) exec "$ROOT/scripts/install.sh" "$@" ;;
  doctor) exec "$ROOT/scripts/doctor.sh" "$@" ;;
  test) exec "$ROOT/scripts/test.sh" "$@" ;;
  backup) exec "$ROOT/scripts/backup.sh" "$@" ;;
  restore|import)
    need_env
    exec "$ROOT/scripts/restore.sh" "$@"
    ;;
  remove)
    need_env
    exec "$ROOT/scripts/remove.sh" "$@"
    ;;
  update) exec "$ROOT/scripts/update.sh" "$@" ;;
  mailbox)
    need_env
    exec "$ROOT/scripts/mailbox.sh" "$@"
    ;;
  fetch-llm)
    exec "$ROOT/scripts/fetch-llm.sh" "$@"
    ;;
  render-monitoring)
    exec "$ROOT/scripts/render-monitoring.sh" "$@"
    ;;
  demo)
    need_env
    PORT="$(port_from_env)"
    # shellcheck disable=SC1091
    source secrets/secrets.env
    echo "Generating demo incident workflow..."
    jar="$(mktemp)"
    curl -fsS -c "$jar" -b "$jar" -X POST "http://127.0.0.1:${PORT}/login" \
      -d "email=${FORGESRE_ADMIN_EMAIL}&password=${FORGESRE_ADMIN_PASSWORD}" >/dev/null
    curl -fsS -c "$jar" -b "$jar" -X POST "http://127.0.0.1:${PORT}/api/v1/demo"
    echo
    echo "Open the UI dashboard, then:"
    echo "  1. Asset forge-demo-01 (owner contacts + similar HighCPU history)"
    echo "  2. The new incident (Who to call = platform@forgesre.local)"
    echo "  3. /escalation for the generated owner notification"
    echo "Demo discovery candidate: 10.20.30.41 on /discovery"
    rm -f "$jar"
    ;;
  demo-rca)
    need_env
    PORT="$(port_from_env)"
    # shellcheck disable=SC1091
    source secrets/secrets.env
    echo "Generating filesystem RCA demo..."
    jar="$(mktemp)"
    curl -fsS -c "$jar" -b "$jar" -X POST "http://127.0.0.1:${PORT}/login" \
      -d "email=${FORGESRE_ADMIN_EMAIL}&password=${FORGESRE_ADMIN_PASSWORD}" >/dev/null
    curl -fsS -c "$jar" -b "$jar" -X POST "http://127.0.0.1:${PORT}/api/v1/demo-rca"
    echo
    rm -f "$jar"
    ;;
  demo-reset)
    need_env
    PORT="$(port_from_env)"
    # shellcheck disable=SC1091
    source secrets/secrets.env
    jar="$(mktemp)"
    curl -fsS -c "$jar" -b "$jar" -X POST "http://127.0.0.1:${PORT}/login" \
      -d "email=${FORGESRE_ADMIN_EMAIL}&password=${FORGESRE_ADMIN_PASSWORD}" >/dev/null
    curl -fsS -c "$jar" -b "$jar" -X POST "http://127.0.0.1:${PORT}/api/v1/demo-reset"
    echo
    echo "Demo gauges reset to 12% CPU / 35% disk."
    rm -f "$jar"
    ;;
  jobs)
    need_env
    PORT="$(port_from_env)"
    # shellcheck disable=SC1091
    source secrets/secrets.env
    jar="$(mktemp)"
    curl -fsS -c "$jar" -b "$jar" -X POST "http://127.0.0.1:${PORT}/login" \
      -d "email=${FORGESRE_ADMIN_EMAIL}&password=${FORGESRE_ADMIN_PASSWORD}" >/dev/null
    curl -fsS -c "$jar" -b "$jar" "http://127.0.0.1:${PORT}/api/v1/jobs"
    echo
    rm -f "$jar"
    ;;
  secrets-check)
    need_env
    # shellcheck disable=SC1091
    source secrets/secrets.env
    fail=0
    if [[ "${SECRET_KEY:-}" == "forgesre-dev-secret-change-me" || -z "${SECRET_KEY:-}" ]]; then
      echo "SECRET_KEY is the shipped default — Core will refuse to start without FORGESRE_DEV=1."
      fail=1
    else
      echo "SECRET_KEY: set"
    fi
    if [[ "${ALERTMANAGER_WEBHOOK_TOKEN:-}" == "forgesre-dev-webhook-token" || "${ALERTMANAGER_WEBHOOK_TOKEN:-}" == "CHANGE-ME-RENDER-MONITORING" || -z "${ALERTMANAGER_WEBHOOK_TOKEN:-}" ]]; then
      echo "ALERTMANAGER_WEBHOOK_TOKEN is a shipped placeholder — HTTP SD and doctor will be unsafe/broken."
      fail=1
    else
      echo "ALERTMANAGER_WEBHOOK_TOKEN: set"
    fi
    exit "$fail"
    ;;
  status)
    "${DC[@]}" ps
    ;;
  logs)
    "${DC[@]}" logs --tail 100 "$@"
    ;;
  journal)
    need_env
    PORT="$(port_from_env)"
    # shellcheck disable=SC1091
    source secrets/secrets.env
    module="${1:-}"
    jar="$(mktemp)"
    curl -fsS -c "$jar" -b "$jar" -X POST "http://127.0.0.1:${PORT}/login" \
      -d "email=${FORGESRE_ADMIN_EMAIL}&password=${FORGESRE_ADMIN_PASSWORD}" >/dev/null
    if [[ -n "$module" ]]; then
      curl -fsS -c "$jar" -b "$jar" "http://127.0.0.1:${PORT}/api/v1/journal?module=${module}&limit=50"
    else
      curl -fsS -c "$jar" -b "$jar" "http://127.0.0.1:${PORT}/api/v1/journal?limit=50"
    fi
    echo
    rm -f "$jar"
    ;;
  config)
    sed -n '1,160p' config/forgesre.yml
    ;;
  assets|inventory)
    need_env
    run_cli_ops assets "$@"
    ;;
  snmp)
    cmd_snmp
    ;;
  ping|probe)
    need_env
    run_cli_ops ping "$@"
    ;;
  verify)
    need_env
    run_cli_ops verify "$@"
    ;;
  incidents)
    need_env
    run_cli_ops incidents "$@"
    ;;
  history)
    need_env
    run_cli_ops history "$@"
    ;;
  login)
    need_env
    if [[ $# -ge 2 ]]; then
      run_cli_ops login "$1" "$2"
    elif [[ -n "${FORGESRE_CLI_EMAIL:-}" && -n "${FORGESRE_CLI_PASSWORD:-}" ]]; then
      run_cli_ops login "$FORGESRE_CLI_EMAIL" "$FORGESRE_CLI_PASSWORD"
    else
      if [[ ! -t 0 ]]; then
        echo "usage: ./forgesre login EMAIL PASSWORD"
        exit 1
      fi
      read -r -p "ForgeSRE email: " email
      read -r -s -p "Password: " password
      echo
      run_cli_ops login "$email" "$password"
    fi
    ;;
  logout)
    PYTHONPATH="$ROOT/backend" python3 -m app.cli_ops 0 logout
    ;;
  whoami)
    need_env
    run_cli_ops whoami
    ;;
  completion)
    echo "source \"$ROOT/scripts/forgesre-completion.bash\""
    ;;
  sd)
    need_env
    PORT="$(port_from_env)"
    # shellcheck disable=SC1091
    source secrets/secrets.env
    echo "=== Linux node_exporter / Windows windows_exporter HTTP SD ==="
    curl -sS -H "Authorization: Bearer ${ALERTMANAGER_WEBHOOK_TOKEN}" \
      "http://127.0.0.1:${PORT}/api/v1/sd/prometheus" || true
    echo
    echo
    echo "=== SNMP HTTP SD ==="
    curl -sS -H "Authorization: Bearer ${ALERTMANAGER_WEBHOOK_TOKEN}" \
      "http://127.0.0.1:${PORT}/api/v1/sd/snmp" || true
    echo
    ;;
  version)
    if [[ -f .env ]] && grep -q '^FORGESRE_VERSION=' .env; then
      awk -F= '/^FORGESRE_VERSION=/ {print $2}' .env | tail -1 | tr -d '"'
    else
      echo "0.7.0"
    fi
    ;;
  tls)
    print_help_command tls
    ;;
  quit|exit)
    print_help_command quit
    ;;
  *)
    echo "Unknown command: $cmd"
    echo
    print_overview
    exit 1
    ;;
esac
