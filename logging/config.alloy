local.file_match "forgesre_logs" {
  path_targets = [{
    __path__ = "/var/log/forgesre/*.log",
    job      = "forgesre",
    asset    = "forge-demo-01",
  }]
}

loki.source.file "forgesre" {
  targets    = local.file_match.forgesre_logs.targets
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
