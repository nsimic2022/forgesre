# =============================================================================
# ForgeSRE secrets — secrets/secrets.env
# =============================================================================
# Purpose: passwords, tokens, and signing keys for containers and Core.
# Where:   secrets/secrets.env (directory mode 700, file mode 600).
# Install: ./install.sh copies this file to secrets/secrets.env and fills values
#          (new VM only — never re-run install on a live box).
# Manual:  cp secrets/secrets.example.env secrets/secrets.env
#          chmod 700 secrets && chmod 600 secrets/secrets.env
#
# PLAINTEXT: every value in this file is plaintext for Docker / Postgres / NetBox /
# Grafana / SMTP / SNMP. They are NOT password hashes.
#
# bcrypt (Postgres only): ForgeSRE UI users store bcrypt in table users.password_hash.
# FORGESRE_ADMIN_PASSWORD is read at first Core boot to seed the install admin row.
# Changing FORGESRE_ADMIN_PASSWORD here after first boot does NOT update the DB —
# change the user in Administration (or recreate the user row). Keep this file in
# sync if the CLI still falls back to FORGESRE_ADMIN_* when no ./forgesre login
# session exists.
#
# Do not commit secrets/secrets.env. Do not merge this file into repo-root `.env`.
# =============================================================================

# --- Postgres ---
# Used by service postgres and by Core DATABASE_URL. Plaintext.
POSTGRES_PASSWORD=

# --- ForgeSRE Core ---
# Install bootstrap admin (email + plaintext password). Seeded once into Postgres
# as bcrypt on first Core start. After that, the live login hash is only in the DB.
FORGESRE_ADMIN_EMAIL=admin@forgesre.local
FORGESRE_ADMIN_PASSWORD=
# Session cookie signing key (must not be the shipped lab default).
SECRET_KEY=
# Bearer token for Prometheus HTTP SD and Alertmanager → Core webhook.
ALERTMANAGER_WEBHOOK_TOKEN=

# --- Grafana ---
# GF_SECURITY_ADMIN_PASSWORD for the bundled Grafana UI (:3000). Plaintext.
GRAFANA_ADMIN_PASSWORD=

# --- SMTP ---
# Used when notifications.email.enabled is true in config/forgesre.yml.
# ./forgesre mailbox --bind-core may fill these for the local mailserver.
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional extras written by mailbox bind-core (host/port usually live in YAML):
# SMTP_HOST=
# SMTP_PORT=
# SMTP_FROM=
# SMTP_USE_TLS=

# --- SNMP ---
# SNMPv2c community for discovery and snmp_exporter targets. Lab default public.
SNMP_COMMUNITY=public

# --- NetBox ---
# Django superuser for the NetBox UI at :8001. Plaintext for the NetBox container.
# First boot creates the user; changing SUPERUSER_PASSWORD later may not update
# an existing NetBox user — rotate inside the NetBox UI if needed.
NETBOX_SUPERUSER_NAME=admin
NETBOX_SUPERUSER_EMAIL=admin@forgesre.local
NETBOX_SUPERUSER_PASSWORD=
# Dedicated NetBox Postgres role / Redis / Django SECRET_KEY. Plaintext.
NETBOX_DB_PASSWORD=
NETBOX_REDIS_PASSWORD=
NETBOX_SECRET_KEY=
# Prefer full NetBox UI v2 token (nbt_… shown once). 40-char v1 is launch fallback.
# Core reads this from the bind-mounted secrets file (not only from `.env`).
NETBOX_API_TOKEN=
# Alias used by NetBox launch / upsert helpers (kept equal to NETBOX_API_TOKEN).
SUPERUSER_API_TOKEN=
# NetBox v4.5+ UI v2 token peppers (≥50 chars). Compose maps pepper → API_TOKEN_PEPPER_1.
NETBOX_API_TOKEN_PEPPER=
API_TOKEN_PEPPER_1=

# --- Optional mailbox ---
# MAILBOX_DOMAIN=
# MAILBOX_USERNAME=
# MAILBOX_PASSWORD=
